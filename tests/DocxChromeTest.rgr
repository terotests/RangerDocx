; ==============================================================================
; DocxChromeTest — the word processor's frame: ribbon, navigation pane, rulers
; and status bar (src/DocxChrome.rgr), and the paragraph commands it brought
; (alignment and styles, src/DocxParaFormat.rgr).
;
;   npm run docx_viewer:chrome:test
; ==============================================================================

Import "../src/DocxApp.rgr"

class ChromeCheck {
    def passed:int 0
    def failed:int 0

    fn ok:void (name:string cond:boolean) {
        if cond {
            passed = (passed + 1)
            print ("  PASS " + name)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
        }
    }

    fn eqInt:void (name:string got:int want:int) {
        this.ok((name + " (got " + (to_string got) + " want " + (to_string want) + ")") (got == want))
    }

    fn eqStr:void (name:string got:string want:string) {
        this.ok((name + " (got '" + got + "' want '" + want + "')") (got == want))
    }
}

class DocxChromeTest {
    sfn build:DocxApp (file:string) {
        def app:DocxApp (new DocxApp)
        app.init()
        app.setRibbonUi(true)
        app.resize(1400 900)
        app.setContinuous(true)
        if ((app.viewer.openFile("gallery/docx_viewer/fixtures" file)) == false) {
            print ("  could not open " + file)
        }
        app.markOpened(file)
        app.buildDisplayList()
        return app
    }

    sfn click:void (app:DocxApp x:int y:int) {
        app.pointer(x y true true false false)
        app.pointer(x y false false true false)
    }

    ; The first body paragraph whose style is `sid`.
    sfn firstWithStyle:int (app:DocxApp sid:string) {
        def d:RichDocument app.viewer.doc
        def i:int 0
        while (i < (array_length d.blocks)) {
            def b:DocBlock (itemAt d.blocks i)
            if (b.kind == (DocBlockKind.para())) {
                if (b.paragraph.styleId == sid) {
                    return b.paragraph.id
                }
            }
            i = (i + 1)
        }
        return 0
    }

    sfn paragraph:Paragraph (app:DocxApp pid:int) {
        return (app.viewer.edit.adapter.findParagraph(pid))
    }

    sfn main:void () {
        def c:ChromeCheck (new ChromeCheck)

        print "-- the ribbon --"
        def app:DocxApp (DocxChromeTest.build("20-business-report.docx"))
        c.eqStr("the ribbon opens on Home" (app.ribbon.tabName()) "Home")
        def names:string ""
        def gi:int 0
        while (gi < (array_length app.ribbon.groups)) {
            def g:RibbonGroup (itemAt app.ribbon.groups gi)
            names = (names + g.name + ",")
            gi = (gi + 1)
        }
        c.eqStr("Home has the groups a word processor has" names "Clipboard,Font,Paragraph,Styles,Editing,Mode,")
        def unplaced:int 0
        def ii:int 0
        while (ii < (array_length app.ribbon.items)) {
            def it:RibbonItem (app.ribbon.at(ii))
            if ((it.w <= 0) || (it.h <= 0)) {
                unplaced = (unplaced + 1)
            }
            ii = (ii + 1)
        }
        c.eqInt("every button on the page has a place" unplaced 0)
        def bi:int (app.ribbon.indexOf("format.bold" ""))
        def bold:RibbonItem (app.ribbon.at(bi))
        def italic:RibbonItem (app.ribbon.at((app.ribbon.indexOf("format.italic" ""))))
        def font:RibbonItem (app.ribbon.at((app.ribbon.indexOf("format.font" ""))))
        c.ok("Font's two rows: the boxes above, bold below" (bold.y > font.y))
        c.ok("and bold sits left of italic" (bold.x < italic.x))
        def groupLabelsInside:boolean true
        def gj:int 0
        while (gj < (array_length app.ribbon.groups)) {
            def g2:RibbonGroup (itemAt app.ribbon.groups gj)
            def ci:int 0
            while (ci < (array_length g2.cells)) {
                def cell:RibbonCell (itemAt g2.cells ci)
                if ((cell.x + cell.w) > (g2.x + g2.w)) {
                    groupLabelsInside = false
                }
                ci = (ci + 1)
            }
            gj = (gj + 1)
        }
        c.ok("every column stays inside its group" groupLabelsInside)
        def painter:RibbonItem (app.ribbon.at((app.ribbon.indexOf("edit.replace" ""))))
        c.ok("a command that does not exist yet is drawn greyed" (painter.enabled == false))

        ; Switching pages.
        def view:int (app.ribbon.tabIndex("View"))
        DocxChromeTest.click(app ((itemAt app.ribbon.tabX view) + 5) (app.titleH + 10))
        c.eqStr("a press on View shows the View page" (app.ribbon.tabName()) "View")
        app.buildDisplayList()
        def navBtn:RibbonItem (app.ribbon.at((app.ribbon.indexOf("view.nav" ""))))
        c.ok("the pane's switch shows it on" navBtn.pressed)
        DocxChromeTest.click(app (navBtn.x + 4) (navBtn.y + 4))
        c.ok("and pressing it hides the pane" (app.nav.visible == false))
        DocxChromeTest.click(app (navBtn.x + 4) (navBtn.y + 4))
        c.ok("and again shows it" app.nav.visible)
        def home:int (app.ribbon.tabIndex("Home"))
        DocxChromeTest.click(app ((itemAt app.ribbon.tabX home) + 5) (app.titleH + 10))
        app.buildDisplayList()

        print "-- the frame's geometry --"
        c.ok("the paper starts right of the pane and the ruler" (app.pageX >= (app.nav.w + app.vRulerW)))
        c.ok("and under the ribbon and the ruler" ((app.pageTop()) == ((app.titleH + (app.ribbon.height())) + app.rulerH)))
        c.eqInt("the status bar is the frame's foot" ((app.pageTop()) + (app.pageAreaH()) + app.statusH) app.H)

        print "-- the navigation pane --"
        def titleStyle:int (DocxChromeTest.firstWithStyle(app "Title"))
        def headings:int 0
        def h1:int 0
        def ni:int 0
        while (ni < (array_length app.nav.entries)) {
            def e:NavEntry (itemAt app.nav.entries ni)
            headings = (headings + 1)
            if (e.level == 1) {
                h1 = (h1 + 1)
            }
            ni = (ni + 1)
        }
        c.ok("the pane lists the headings" (headings >= 6))
        c.ok("with the top level among them" (h1 >= 4))
        def first:NavEntry (itemAt app.nav.entries 0)
        c.ok("the title is not a heading" (first.paragraphId != titleStyle))
        def last:NavEntry (itemAt app.nav.entries ((array_length app.nav.entries) - 1))
        c.ok("a later heading is on a later page" (last.page > 0))
        ; Clicking it goes there.
        app.buildDisplayList()
        DocxChromeTest.click(app (app.nav.x + 40) (last.y + 6))
        c.eqInt("a click on a heading goes to its page" app.viewer.currentPage last.page)
        c.eqInt("and puts the caret on it" app.viewer.edit.sel.focus.paragraphId last.paragraphId)
        c.ok("scrolling the desk there" (app.docScroll > 0))

        print "-- search --"
        app.runCommand("edit.find" "")
        c.ok("Find opens the pane on its results" ((app.nav.mode == 2) && app.nav.searchFocused))
        app.text("revenue")
        c.eqStr("typing goes into the search field, not the document" app.nav.query "revenue")
        app.buildDisplayList()
        c.ok("and finds paragraphs" ((array_length app.nav.entries) > 0))
        app.key("backspace" false false)
        c.eqStr("Backspace edits the query" app.nav.query "revenu")
        app.key("enter" false false)
        def hitE:NavEntry (itemAt app.nav.entries 0)
        c.eqInt("Enter goes to the first result" app.viewer.edit.sel.focus.paragraphId hitE.paragraphId)
        app.key("tab" false false)
        c.ok("Tab leaves the field" (app.nav.searchFocused == false))

        print "-- alignment --"
        def a2:DocxApp (DocxChromeTest.build("20-business-report.docx"))
        a2.viewer.setEditMode(true)
        def pid:int (DocxChromeTest.firstWithStyle(a2 "Normal"))
        c.ok("there is a body paragraph" (pid > 0))
        a2.viewer.edit.setCaret(pid 2)
        def before:int (DocxChromeTest.alignOf(a2 pid))
        def rev:int a2.viewer.doc.revision
        c.ok("Centre runs" (a2.runCommand("para.align" "1")))
        c.eqInt("and centres the paragraph" (DocxChromeTest.alignOf(a2 pid)) 1)
        c.ok("the document says it changed" (a2.viewer.doc.revision > rev))
        a2.buildDisplayList()
        def centre:RibbonItem (a2.ribbon.at((a2.ribbon.indexOf("para.align" "1"))))
        c.ok("the ribbon shows Centre pressed" centre.pressed)
        a2.runCommand("edit.undo" "")
        c.eqInt("undo puts the alignment back" (DocxChromeTest.alignOf(a2 pid)) before)
        a2.runCommand("edit.redo" "")
        c.eqInt("and redo centres it again" (DocxChromeTest.alignOf(a2 pid)) 1)

        ; Across a selection of three paragraphs.
        def o0:int (a2.viewer.edit.adapter.bodyOrderOf(pid))
        def p2:int (a2.viewer.edit.adapter.bodyParagraphIdAt((o0 + 2)))
        a2.viewer.edit.setCaret(pid 0)
        a2.viewer.edit.extendTo(p2 1)
        a2.runCommand("para.align" "2")
        def mid:int (a2.viewer.edit.adapter.bodyParagraphIdAt((o0 + 1)))
        c.eqInt("a selection aligns every paragraph in it" (DocxChromeTest.alignOf(a2 mid)) 2)
        c.eqInt("to the last one" (DocxChromeTest.alignOf(a2 p2)) 2)

        print "-- styles --"
        def a3:DocxApp (DocxChromeTest.build("20-business-report.docx"))
        a3.viewer.setEditMode(true)
        def sp:int (DocxChromeTest.firstWithStyle(a3 "Normal"))
        a3.viewer.edit.setCaret(sp 0)
        def para:Paragraph (DocxChromeTest.paragraph(a3 sp))
        def span0:TextSpan (itemAt para.spans 0)
        def sizeBefore:double span0.fontSizePt
        def h1Style:ResolvedParagraphStyle (a3.viewer.parser.resolver.resolveParagraphStyle("Heading1"))
        c.ok("Heading 1 runs" (a3.runCommand("format.style" "Heading1")))
        def styled:Paragraph (DocxChromeTest.paragraph(a3 sp))
        c.eqStr("the paragraph is a Heading 1" styled.styleId "Heading1")
        def firstSpan:TextSpan (itemAt styled.spans 0)
        c.ok("its text took the heading's size" (firstSpan.fontSizePt == h1Style.run.fontSizePt))
        c.ok("which is not the body size" (firstSpan.fontSizePt != sizeBefore))
        a3.buildDisplayList()
        def tileI:int (a3.ribbon.indexOf("format.style" "Heading1"))
        def tile:RibbonItem (a3.ribbon.at(tileI))
        c.ok("the gallery shows Heading 1 pressed" tile.pressed)
        def noSp:RibbonItem (a3.ribbon.at((a3.ribbon.indexOf("format.style" "NoSpacing"))))
        c.ok("a style the file does not have is greyed" (noSp.enabled == false))
        c.ok("the new heading is in the pane" (DocxChromeTest.navHas(a3 sp)))
        a3.runCommand("edit.undo" "")
        def back:Paragraph (DocxChromeTest.paragraph(a3 sp))
        c.eqStr("undo makes it body text again" back.styleId "Normal")
        def backSpan:TextSpan (itemAt back.spans 0)
        c.ok("at the body size" (backSpan.fontSizePt == sizeBefore))

        ; Saved and read back.
        a3.runCommand("edit.redo" "")
        def bytes:buffer (a3.viewer.saveBytes())
        def a4:DocxApp (new DocxApp)
        a4.init()
        c.ok("the styled document saves and opens" (a4.viewer.openBytes(bytes "styled.docx")))
        def again:Paragraph (DocxChromeTest.paragraph(a4 sp))
        c.eqStr("with the heading style kept" again.styleId "Heading1")

        print "-- character formatting --"
        def a5:DocxApp (DocxChromeTest.build("20-business-report.docx"))
        a5.viewer.setEditMode(true)
        def rp:int (DocxChromeTest.firstWithStyle(a5 "Normal"))
        a5.viewer.edit.setRange(rp 0 7)
        c.ok("Strikethrough runs" (a5.runCommand("format.strike" "")))
        c.ok("and strikes the selection" (a5.viewer.edit.adapter.rangeIsOn(rp 0 7 "strike")))
        a5.buildDisplayList()
        def stBtn:RibbonItem (a5.ribbon.at((a5.ribbon.indexOf("format.strike" ""))))
        c.ok("the button shows it pressed" stBtn.pressed)
        a5.runCommand("edit.undo" "")
        c.ok("undo takes it off" ((a5.viewer.edit.adapter.rangeIsOn(rp 0 7 "strike")) == false))
        a5.viewer.edit.setRange(rp 0 3)
        a5.runCommand("format.superscript" "")
        c.ok("superscript" (a5.viewer.edit.adapter.rangeIsOn(rp 0 3 "super")))
        a5.runCommand("format.subscript" "")
        c.ok("subscript replaces it" ((a5.viewer.edit.adapter.rangeIsOn(rp 0 3 "sub")) && ((a5.viewer.edit.adapter.rangeIsOn(rp 0 3 "super")) == false)))
        a5.viewer.edit.setRange(rp 3 9)
        a5.runCommand("format.highlight" "")
        c.ok("the highlighter paints yellow" (a5.viewer.edit.adapter.rangeIsOn(rp 3 9 "highlight")))
        a5.viewer.edit.setRange(rp 0 9)
        a5.runCommand("format.bold" "")
        a5.runCommand("format.italic" "")
        a5.runCommand("format.clear" "")
        def cleared:boolean ((((a5.viewer.edit.adapter.rangeIsOn(rp 0 9 "bold")) || (a5.viewer.edit.adapter.rangeIsOn(rp 0 9 "italic"))) || (a5.viewer.edit.adapter.rangeIsOn(rp 3 9 "highlight"))) || (a5.viewer.edit.adapter.rangeIsOn(rp 0 3 "sub")))
        c.ok("Clear formatting takes all of it off" (cleared == false))
        def textBefore:string (a5.viewer.edit.adapter.getText(rp))
        ; A stretch with lower case letters in it, so the first press has work.
        def cs:int 0
        while ((cs + 7) < (strlen textBefore)) {
            def w:string (substring textBefore cs (cs + 7))
            if ((w == (to_lowercase w)) && (w != (to_uppercase w))) {
                break
            }
            cs = (cs + 1)
        }
        def orig:string (substring textBefore cs (cs + 7))
        a5.viewer.edit.setRange(rp cs (cs + 7))
        a5.runCommand("format.case" "")
        def up:string (a5.viewer.edit.adapter.getText(rp))
        c.eqStr("Change case: UPPER first" (substring up cs (cs + 7)) (to_uppercase orig))
        a5.runCommand("format.case" "")
        def tc:string (a5.viewer.edit.adapter.getText(rp))
        c.eqStr("then Title Case" (substring tc cs (cs + 7)) (DocxParaFormat.titleCase(orig)))
        a5.runCommand("format.case" "")
        def lc:string (a5.viewer.edit.adapter.getText(rp))
        c.eqStr("then lower case" (substring lc cs (cs + 7)) (to_lowercase orig))
        a5.runCommand("edit.undo" "")
        a5.runCommand("edit.undo" "")
        a5.runCommand("edit.undo" "")
        c.eqStr("undo restores the text" (a5.viewer.edit.adapter.getText(rp)) textBefore)
        ; Typing after the button, with nothing selected, types struck text.
        a5.viewer.edit.setCaret(rp 2)
        a5.runCommand("format.strike" "")
        a5.text("QQ")
        c.ok("a toggle with no selection applies to what is typed" (a5.viewer.edit.adapter.rangeIsOn(rp 2 4 "strike")))
        ; Written and read back.
        a5.viewer.edit.setRange(rp 5 8)
        a5.runCommand("format.superscript" "")
        a5.viewer.edit.setRange(rp 8 10)
        a5.runCommand("format.highlight" "green")
        def b5:buffer (a5.viewer.saveBytes())
        def a6:DocxApp (new DocxApp)
        a6.init()
        c.ok("saves and opens" (a6.viewer.openBytes(b5 "fmt.docx")))
        c.ok("strikethrough survives the round trip" (a6.viewer.edit.adapter.rangeIsOn(rp 2 4 "strike")))
        c.ok("so does superscript" (a6.viewer.edit.adapter.rangeIsOn(rp 5 8 "super")))
        c.ok("and the highlight" (a6.viewer.edit.adapter.rangeIsOn(rp 8 10 "highlight")))
        def dl6:EVGDisplayList (a6.viewer.pageDisplayList(0))
        c.ok("and it all draws" ((array_length dl6.cmds) > 20))

        print "-- lists, indents and spacing --"
        def l1:DocxApp (DocxChromeTest.build("20-business-report.docx"))
        l1.viewer.setEditMode(true)
        def lp:int (DocxChromeTest.firstWithStyle(l1 "Normal"))
        def lo:int (l1.viewer.edit.adapter.bodyOrderOf(lp))
        def lp2:int (l1.viewer.edit.adapter.bodyParagraphIdAt((lo + 1)))
        l1.viewer.edit.setRange(lp 0 0)
        l1.viewer.edit.sel.focus = (DocumentPosition.create(lp2 2))
        c.ok("Bullets runs" (l1.runCommand("para.bullets" "")))
        def b1:Paragraph (DocxChromeTest.paragraph(l1 lp))
        def b2:Paragraph (DocxChromeTest.paragraph(l1 lp2))
        c.ok("both paragraphs are in a list" ((b1.listNumId > 0) && (b1.listNumId == b2.listNumId)))
        c.eqStr("a bulleted one" (l1.viewer.numbering.kindOf(b1.listNumId)) "bullet")
        c.ok("indented by the list" (b1.indentLeftPt > 0.0))
        l1.buildDisplayList()
        def blBtn:RibbonItem (l1.ribbon.at((l1.ribbon.indexOf("para.bullets" ""))))
        c.ok("the Bullets button shows it" blBtn.pressed)
        l1.runCommand("para.bullets" "")
        c.ok("a second press takes them out" ((DocxChromeTest.numOf(l1 lp)) == 0))
        l1.runCommand("edit.undo" "")
        c.ok("undo puts them back" ((DocxChromeTest.numOf(l1 lp)) > 0))
        l1.runCommand("para.numbering" "")
        def n1:Paragraph (DocxChromeTest.paragraph(l1 lp))
        c.eqStr("Numbering turns the bullets into numbers" (l1.viewer.numbering.kindOf(n1.listNumId)) "number")
        ; The dropdown: opened from the button's arrow, a line picks a look.
        def nb:RibbonItem (l1.ribbon.at((l1.ribbon.indexOf("para.numbering" ""))))
        DocxChromeTest.click(l1 ((nb.x + nb.w) - 4) (nb.y + 6))
        c.ok("the arrow opens the numbering library" (l1.ribbon.menu.open && (l1.ribbon.menu.owner == "para.numbering")))
        def pick:int -1
        def mi:int 0
        while (mi < (array_length l1.ribbon.menu.entries)) {
            def me:RibbonMenuEntry (l1.ribbon.menu.at(mi))
            if (me.arg == "lowerLetter:%1)") {
                pick = mi
            }
            mi = (mi + 1)
        }
        c.ok("which has a) b) c)" (pick >= 0))
        DocxChromeTest.click(l1 (l1.ribbon.menu.x + 40) ((l1.ribbon.menu.y + 5) + ((pick * (l1.ribbon.menu.rowH())) + 10)))
        c.ok("a press on a line shuts the list" (l1.ribbon.menu.open == false))
        def n2:Paragraph (DocxChromeTest.paragraph(l1 lp))
        c.eqStr("and gives the list that look" (l1.viewer.numbering.styleOf(n2.listNumId)) "lowerLetter:%1)")
        l1.viewer.edit.setCaret(lp2 0)
        l1.runCommand("text.indent" "")
        c.eqInt("Increase indent moves a list item a level down" (DocxChromeTest.levelOf(l1 lp2)) 1)
        l1.runCommand("text.outdent" "")
        c.eqInt("and Decrease indent back" (DocxChromeTest.levelOf(l1 lp2)) 0)
        def plain:int (l1.viewer.edit.adapter.bodyParagraphIdAt((lo + 3)))
        l1.viewer.edit.setCaret(plain 0)
        def left0:double (DocxChromeTest.leftOf(l1 plain))
        l1.runCommand("text.indent" "")
        def left1:double (DocxChromeTest.leftOf(l1 plain))
        c.ok("outside a list it indents to the next half inch" ((left1 > left0) && (left1 <= (left0 + 36.01))))
        def sp0:RibbonItem (l1.ribbon.at((l1.ribbon.indexOf("para.spacing" ""))))
        DocxChromeTest.click(l1 (sp0.x + 6) (sp0.y + 6))
        c.ok("Line spacing opens its list" (l1.ribbon.menu.open && ((array_length l1.ribbon.menu.entries) >= 6)))
        l1.ribbon.menu.close()
        l1.runCommand("para.spacing" "2.0")
        c.ok("double spacing" ((DocxChromeTest.lineOf(l1 plain)) == 2.0))
        def before0:double (DocxChromeTest.beforeOf(l1 plain))
        l1.runCommand("para.spaceBefore" "")
        c.ok("space before goes on, or off when there was some" ((DocxChromeTest.beforeOf(l1 plain)) == (? (before0 > 0.0) 0.0 12.0)))
        l1.runCommand("edit.undo" "")
        l1.runCommand("edit.undo" "")
        c.ok("undo takes the spacing back" ((DocxChromeTest.lineOf(l1 plain)) != 2.0))
        ; Saved: the new list is in numbering.xml, and opens as the same list.
        def lb:buffer (l1.viewer.saveBytes())
        def l2:DocxApp (new DocxApp)
        l2.init()
        c.ok("the document with a new list saves and opens" (l2.viewer.openBytes(lb "lists.docx")))
        def r1:Paragraph (DocxChromeTest.paragraph(l2 lp))
        c.eqStr("with the list's look" (l2.viewer.numbering.styleOf(r1.listNumId)) "lowerLetter:%1)")
        c.eqInt("and its levels" (DocxChromeTest.levelOf(l2 lp2)) 0)
        ; A document without numbering.xml gets one.
        def l3:DocxApp (DocxChromeTest.build("21-accented-text.docx"))
        l3.viewer.setEditMode(true)
        def ap:int (l3.viewer.edit.adapter.bodyParagraphIdAt(0))
        l3.viewer.edit.setCaret(ap 0)
        l3.runCommand("para.numbering" "")
        def l4:DocxApp (new DocxApp)
        l4.init()
        c.ok("a file with no lists saves one" (l4.viewer.openBytes((l3.viewer.saveBytes()) "numbered.docx")))
        def r2:Paragraph (DocxChromeTest.paragraph(l4 ap))
        c.eqStr("and it reads back numbered" (l4.viewer.numbering.kindOf(r2.listNumId)) "number")
        ; Change case from its list.
        l1.viewer.edit.setRange(plain 0 5)
        def wordBefore:string (substring (l1.viewer.edit.adapter.getText(plain)) 0 5)
        l1.runCommand("format.case" "lower")
        c.eqStr("lowercase from the list" (substring (l1.viewer.edit.adapter.getText(plain)) 0 5) (to_lowercase wordBefore))

        print "-- painter, page break, table, replace --"
        def e1:DocxApp (DocxChromeTest.build("20-business-report.docx"))
        e1.viewer.setEditMode(true)
        def ep:int (DocxChromeTest.firstWithStyle(e1 "Normal"))
        def eo:int (e1.viewer.edit.adapter.bodyOrderOf(ep))
        def eq:int (e1.viewer.edit.adapter.bodyParagraphIdAt((eo + 2)))
        e1.viewer.edit.setRange(ep 0 4)
        e1.runCommand("format.bold" "")
        e1.runCommand("format.highlight" "green")
        e1.viewer.edit.setCaret(ep 1)
        c.ok("the format painter picks up the look" (e1.runCommand("format.painter" "")))
        e1.buildDisplayList()
        def fpb:RibbonItem (e1.ribbon.at((e1.ribbon.indexOf("format.painter" ""))))
        c.ok("and shows armed" fpb.pressed)
        e1.viewer.edit.setRange(eq 0 5)
        e1.runFormat("paint" "")
        c.ok("a selection takes the bold" (e1.viewer.edit.adapter.rangeIsOn(eq 0 5 "bold")))
        c.ok("and the highlight" (e1.viewer.edit.adapter.rangeIsOn(eq 0 5 "highlight")))
        c.ok("one paint disarms it" (e1.viewer.edit.painterArmed == false))
        e1.runCommand("edit.undo" "")
        c.ok("undo takes the paint off" ((e1.viewer.edit.adapter.rangeIsOn(eq 0 5 "bold")) == false))

        def pages0:int (e1.viewer.pageCount())
        def eqText:string (e1.viewer.edit.adapter.getText(eq))
        e1.viewer.edit.setCaret(eq 5)
        c.ok("Ctrl+Enter breaks the page" (e1.key("enter" false true)))
        def brokeId:int (e1.viewer.edit.sel.focus.paragraphId)
        def broke:Paragraph (DocxChromeTest.paragraph(e1 brokeId))
        c.ok("the rest of the paragraph starts a page" (broke.pageBreakBefore && (broke.text == (substring eqText 5 (strlen eqText)))))
        e1.viewer.view.layout.layoutIfNeeded(e1.viewer.doc e1.viewer.view.ctx.tr e1.viewer.numbering)
        def eqPage:int -1
        def brokePage:int -1
        def brokeFirst:int -1
        def dbgP:int 0
        while (dbgP < (e1.viewer.view.layout.pageCount())) {
            def dpg:LaidPage (e1.viewer.view.layout.pageAt(dbgP))
            for dpg.lines dln:LaidLine dli {
                if ((dln.paraIndex == eq) && (eqPage < 0)) {
                    eqPage = dbgP
                }
                if ((dln.paraIndex == brokeId) && (brokePage < 0)) {
                    brokePage = dbgP
                    brokeFirst = dli
                }
            }
            dbgP = (dbgP + 1)
        }
        c.ok("and is laid out at the top of the next page" (((brokePage == (eqPage + 1)) && (brokeFirst == 0)) && ((e1.viewer.pageCount()) >= pages0)))
        e1.runCommand("edit.undo" "")
        c.eqStr("undo joins it again" (e1.viewer.edit.adapter.getText(eq)) eqText)

        def blocks0:int (e1.viewer.doc.blockCount())
        e1.viewer.edit.setCaret(eq 0)
        c.ok("Insert table" (e1.runCommand("insert.table" "3x4")))
        c.ok("adds a block" ((e1.viewer.doc.blockCount()) > blocks0))
        def tbIdx:int (e1.viewer.edit.adapter.tableBlockBeforeParagraph((e1.viewer.edit.sel.focus.paragraphId)))
        c.ok("three rows of four" ((tbIdx >= 0) && (((e1.viewer.edit.adapter.rowCountOfTable(tbIdx)) == 3) && ((e1.viewer.edit.adapter.cellCountInRow(tbIdx 0)) == 4))))
        def tblItem:RibbonItem (e1.ribbon.at((e1.ribbon.indexOf("insert.table" ""))))
        e1.runCommand("edit.undo" "")
        c.eqInt("undo takes the table out" (e1.viewer.doc.blockCount()) blocks0)

        def word:string (substring (e1.viewer.edit.adapter.getText(ep)) 0 4)
        e1.viewer.edit.findQuery = word
        e1.viewer.edit.setCaret(ep 0)
        c.ok("find next lands on a match" (e1.viewer.edit.findNext()))
        c.ok("Replace all" (e1.runCommand("edit.replace" (word + "|ZZZZ"))))
        c.ok("changes the text" ((indexOf (e1.viewer.edit.adapter.getText(ep)) "ZZZZ") == 0))
        c.ok("in the look it replaced" (e1.viewer.edit.adapter.rangeIsOn(ep 0 4 "bold")))
        c.ok("and says how many" ((indexOf e1.viewer.edit.findStatus "replaced") == 0))
        e1.runCommand("edit.undo" "")
        c.ok("undo puts every one back" ((indexOf (e1.viewer.edit.adapter.getText(ep)) "ZZZZ") < 0))
        e1.viewer.edit.findQuery = "e"
        e1.viewer.edit.findWholeWord = true
        e1.viewer.edit.setCaret(ep 0)
        def hit:boolean (e1.viewer.edit.findNext())
        c.ok("whole word skips an e inside a word" ((hit == false) || ((e1.viewer.edit.selectedText()) == "e")))

        print "-- the status bar --"
        c.ok("words are counted" ((app.wordCount()) > 500))
        def z0:double app.zoom
        def sx:int (app.chrome.sliderX(app.W))
        DocxChromeTest.click(app (sx + 110) (app.H - 10))
        c.ok("a press right on the slider zooms in" (app.zoom > z0))
        DocxChromeTest.click(app (sx + 60) (app.H - 10))
        c.ok("and its middle is actual size" ((app.zoom > 0.99) && (app.zoom < 1.01)))

        print "-- and the whole frame draws --"
        def dl:EVGDisplayList (app.buildDisplayList())
        c.ok("there is a picture" ((array_length dl.cmds) > 200))
        def compact:DocxApp (new DocxApp)
        compact.init()
        compact.resize(900 700)
        c.ok("the compact strip is still the default" (compact.ribbonUi == false))

        print ""
        print ("passed=" + (to_string c.passed) + " failed=" + (to_string c.failed))
        if (c.failed == 0) {
            print "ALL PASS"
        } {
            print "FAILURES"
        }
    }

    sfn levelOf:int (app:DocxApp pid:int) {
        def p:Paragraph (DocxChromeTest.paragraph(app pid))
        return p.listLevel
    }

    sfn numOf:int (app:DocxApp pid:int) {
        def p:Paragraph (DocxChromeTest.paragraph(app pid))
        return p.listNumId
    }

    sfn leftOf:double (app:DocxApp pid:int) {
        def p:Paragraph (DocxChromeTest.paragraph(app pid))
        return p.indentLeftPt
    }

    sfn lineOf:double (app:DocxApp pid:int) {
        def p:Paragraph (DocxChromeTest.paragraph(app pid))
        return p.lineSpacing
    }

    sfn beforeOf:double (app:DocxApp pid:int) {
        def p:Paragraph (DocxChromeTest.paragraph(app pid))
        return p.spaceBeforePt
    }

    sfn alignOf:int (app:DocxApp pid:int) {
        def p:Paragraph (DocxChromeTest.paragraph(app pid))
        return p.align
    }

    sfn navHas:boolean (app:DocxApp pid:int) {
        def i:int 0
        while (i < (array_length app.nav.entries)) {
            def e:NavEntry (itemAt app.nav.entries i)
            if (e.paragraphId == pid) {
                return true
            }
            i = (i + 1)
        }
        return false
    }
}
