            cell.fillHex = s.fillHex
            OdtReader.readBorder(s.borderAll cell.borderTop)
            OdtReader.readBorder(s.borderAll cell.borderBottom)
            OdtReader.readBorder(s.borderAll cell.borderLeft)
            OdtReader.readBorder(s.borderAll cell.borderRight)
            OdtReader.readBorder(s.borderTop cell.borderTop)
            OdtReader.readBorder(s.borderBottom cell.borderBottom)
            OdtReader.readBorder(s.borderLeft cell.borderLeft)
            OdtReader.readBorder(s.borderRight cell.borderRight)
