    fn readCell:DocTableCell (doc:RichDocument c:OdtNode) {
        def cell:DocTableCell (new DocTableCell)
        cell.gridSpan = (?? (str2int (c.attr("table:number-columns-spanned"))) 1)
        if (cell.gridSpan < 1) {
            cell.gridSpan = 1
        }
        def none:string "none"
        cell.borderTop.style = none
        cell.borderBottom.style = none
        cell.borderLeft.style = none
        cell.borderRight.style = none
        def st@(optional):OdtStyle (this.findStyle("table-cell" (c.attr("table:style-name"))))
        if (!null? st) {
