            push p.spans base
            push cell.paragraphs p
        }
        return cell
    }

    ; What a cell holds, flattened: the model's cells hold paragraphs, so a
    ; list keeps its paragraphs and a table inside a cell keeps its text.
    fn cellContent:void (doc:RichDocument cell:DocTableCell node:OdtNode level:int) {
        for node.children c:OdtNode ci {
            if (c.isText == false) {
                if ((c.name == "text:p") || (c.name == "text:h")) {
                    def p:Paragraph (doc.addParagraphOnly())
                    this.fillParagraph(doc p c)
                    if (level > 0) {
                        p.indentLeftPt = (p.indentLeftPt + (18.0 * (to_double level)))
                    }
                    push cell.paragraphs p
                }
                if ((c.name == "text:list") || (c.name == "text:list-item")) {
                    this.cellContent(doc cell c (level + 1))
                }
                if (c.name == "text:list-header") {
                    this.cellContent(doc cell c level)
                }
                if (c.name == "table:table") {
                    def rows:[OdtNode]
                    this.collectRows(c rows)
                    for rows r:OdtNode ri {
                        for r.children rc:OdtNode rci {
                            if ((rc.isText == false) && (rc.name == "table:table-cell")) {
                                this.cellContent(doc cell rc level)
                            }
                        }
                    }
                }
                if (OdtReader.isContainer(c.name)) {
                    this.cellContent(doc cell c level)
                }
            }
        }
    }

    ; "0.5pt solid #000000" → style, eighths of a point, colour.
    sfn readBorder:void (spec:string into:DocTableBorder) {
        if ((strlen spec) == 0) {
            return
        }
        if ((indexOf spec "none") >= 0) {
            into.style = "none"
            return
        }
        into.style = "single"
        if ((indexOf spec "double") >= 0) {
            into.style = "double"
        }
        if ((indexOf spec "dotted") >= 0) {
            into.style = "dotted"
        }
        if ((indexOf spec "dashed") >= 0) {
            into.style = "dashed"
        }
        def sp:int (indexOf spec " ")
        if (sp > 0) {
            def pt:double (OdpUnits.toPt((substring spec 0 sp)))
            def sz:int (to_int ((pt * 8.0) + 0.5))
            if (sz < 2) {
                sz = 2
            }
            into.sz = sz
        }
        def hash:int (indexOf spec "#")
        if ((hash >= 0) && ((hash + 7) <= (strlen spec))) {
            into.colorHex = (substring spec (hash + 1) (hash + 7))
        }
    }

    ; ------------------------------------------------------------------
    ; The page
    ; ------------------------------------------------------------------

    ; The first section's page: the master page the first paragraph asked
    ; for, else "Standard", else the first one there is.
    fn applyPage:void (doc:RichDocument) {
        def master:string initialMaster
        if ((strlen master) == 0) {
            master = firstMaster
            def std@(optional):string (get masterLayout "Standard")
            if (!null? std) {
                master = "Standard"
            }
        }
        if ((strlen master) == 0) {
            return
        }
        this.applyMaster(doc (doc.sectionAt(0)) master)
    }

    ; A section laid out as a master page says. ODF puts the header INSIDE
    ; the page margin and Word puts it in the margin, so a page with a header
    ; has the header's height added to its top margin (and the footer's to
    ; the bottom) to start the text where it started.
    fn applyMaster:void (doc:RichDocument sec:DocSection master:string) {
        def hd@(optional):OdtNode (get masterHeader master)
        def ft@(optional):OdtNode (get masterFooter master)
        def plName@(optional):string (get masterLayout master)
        if (!null? plName) {
            def pl@(optional):OdtPageLayout (get pageLayouts (unwrap plName))
            if (!null? pl) {
                def l:OdtPageLayout (unwrap pl)
                sec.pageWTwips = (OdtReader.twips(l.widthPt))
                sec.pageHTwips = (OdtReader.twips(l.heightPt))
                def top:double l.marginTop
                def bottom:double l.marginBottom
                if (!null? hd) {
                    top = (top + l.headerExtra)
                }
                if (!null? ft) {
                    bottom = (bottom + l.footerExtra)
                }
                sec.marginTopTwips = (OdtReader.twips(top))
                sec.marginBottomTwips = (OdtReader.twips(bottom))
                sec.marginLeftTwips = (OdtReader.twips(l.marginLeft))
                sec.marginRightTwips = (OdtReader.twips(l.marginRight))
                sec.landscape = l.landscape
            }
        }
        if (!null? hd) {
            this.readHeaderFooter(doc (unwrap hd) sec.headerParas)
        }
        if (!null? ft) {
            this.readHeaderFooter(doc (unwrap ft) sec.footerParas)
        }
    }

    sfn twips:int (pt:double) {
        return (to_int ((pt * 20.0) + 0.5))
    }

    fn readHeaderFooter:void (doc:RichDocument node:OdtNode into:[Paragraph]) {
        for node.children c:OdtNode ci {
            if (c.isText == false) {
                if ((c.name == "text:p") || (c.name == "text:h")) {
                    def p:Paragraph (doc.addParagraphOnly())
                    this.fillParagraph(doc p c)
                    push into p
                }
            }
        }
    }
}
