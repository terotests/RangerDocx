; ==============================================================================
; OdtXml - the element tree the .odt reader walks
; ==============================================================================
;
; `gallery/xml/XmlCore.rgr` is the parser the .odp reader uses, and this is
; the same parser with its classes renamed. It is not imported because of what
; its names collide with: XmlCore and the spreadsheet's `XmlLite` both define
; `XmlAttr` and `XmlTag`, so a program that holds the Word editor AND a
; spreadsheet (ChartPasteTest, a chart pasted from the grid) would not compile
; once the Word editor imported XmlCore. When those two are reconciled in
; Ranger, this file goes and OdtReader imports XmlCore.
;
; ODF's name policy only: prefixes are kept (`text:p`, `draw:frame`), and
; white space is content inside the elements that hold text.
; ==============================================================================

Import "../../ooxml/OoxmlText.rgr"

class OdtNode {
    def name:string ""
    def attrNames:[string]
    def attrValues:[string]
    def children:[OdtNode]
    def text:string ""
    def isText:boolean false

    Constructor () {
    }

    fn attr:string (n:string) {
        def i:int 0
        while (i < (array_length attrNames)) {
            if ((itemAt attrNames i) == n) {
                return (itemAt attrValues i)
            }
            i = (i + 1)
        }
        return ""
    }

    fn firstChild@(optional):OdtNode (localName:string) {
        for children c:OdtNode ci {
            if ((c.isText == false) && (c.name == localName)) {
                def hit@(optional):OdtNode c
                return hit
            }
        }
        def missing@(optional):OdtNode
        return missing
    }

    ; Depth-first, this node first.
    fn find@(optional):OdtNode (localName:string) {
        if (name == localName) {
            def self@(optional):OdtNode this
            return self
        }
        for children c:OdtNode ci {
            if (c.isText == false) {
                def hit@(optional):OdtNode (c.find(localName))
                if (!null? hit) {
                    return hit
                }
            }
        }
        def missing@(optional):OdtNode
        return missing
    }

    fn textContent:string () {
        if isText {
            return text
        }
        def out:string ""
        for children c:OdtNode ci {
            out = (out + (c.textContent()))
        }
        return out
    }
}

class OdtXmlParser {
    def src:string ""
    def pos:int 0
    def len:int 0
    def maxNodes:int 2000000
    def maxDepth:int 256
    def nodeCount:int 0
    def aborted:boolean false

    Constructor () {
    }

    fn parse@(optional):OdtNode (source:string) {
        src = source
        pos = 0
        len = (strlen source)
        nodeCount = 0
        aborted = false
        ; the prolog, comments and declarations before the root
        while (pos < len) {
            this.skipSpace()
            if (((pos + 1) < len) && ((charAt src pos) == 60)) {
                def n:int (charAt src (pos + 1))
                if ((n == 63) || (n == 33)) {
                    this.skipMarkup()
                } {
                    return (this.readElement(0))
                }
            } {
                pos = len
            }
        }
        def missing@(optional):OdtNode
        return missing
    }

    sfn isSpace:boolean (c:int) {
        return ((((c == 32) || (c == 9)) || (c == 10)) || (c == 13))
    }

    ; Elements whose white-space-only text is content: the space between two
    ; spans is the space between two words.
    sfn keepsSpace:boolean (name:string) {
        return ((((name == "text:p") || (name == "text:h")) || (name == "text:span")) || (name == "text:a"))
    }

    fn skipSpace:void () {
        while ((pos < len) && (OdtXmlParser.isSpace((charAt src pos)))) {
            pos = (pos + 1)
        }
    }

    ; `<?…?>`, `<!--…-->`, `<![CDATA[…]]>` or `<!…>` at `pos`, stepped over.
    fn skipMarkup:void () {
        def n:int (charAt src (pos + 1))
        def endAt:int -1
        def endLen:int 1
        if (n == 63) {
            endAt = (indexOfFrom src "?>" pos)
            endLen = 2
        } {
            if ((indexOfFrom src "<!--" pos) == pos) {
                endAt = (indexOfFrom src "-->" pos)
                endLen = 3
            } {
                endAt = (indexOfFrom src ">" pos)
            }
        }
        if (endAt < 0) {
            pos = len
        } {
            pos = (endAt + endLen)
        }
    }

    fn readName:string () {
        def start:int pos
        while (pos < len) {
            def c:int (charAt src pos)
            if ((((OdtXmlParser.isSpace(c)) || (c == 62)) || (c == 47)) || (c == 61)) {
                break
            }
            pos = (pos + 1)
        }
        return (substring src start pos)
    }

    ; An element whose `<` is at `pos`, with everything inside it.
    fn readElement@(optional):OdtNode (depth:int) {
        def missing@(optional):OdtNode
        if ((depth > maxDepth) || (nodeCount >= maxNodes)) {
            aborted = true
            return missing
        }
        pos = (pos + 1)
        def node:OdtNode (new OdtNode)
        node.name = (this.readName())
        nodeCount = (nodeCount + 1)
        ; attributes
        while (pos < len) {
            this.skipSpace()
            if (pos >= len) {
                return missing
            }
            def ch:int (charAt src pos)
            if (ch == 47) {
                def gt:int (indexOfFrom src ">" pos)
                if (gt < 0) {
                    pos = len
                } {
                    pos = (gt + 1)
                }
                def selfClosed@(optional):OdtNode node
                return selfClosed
            }
            if (ch == 62) {
                pos = (pos + 1)
                break
            }
            def an:string (this.readName())
            if ((strlen an) == 0) {
                pos = (pos + 1)
            } {
                this.skipSpace()
                def value:string ""
                if ((pos < len) && ((charAt src pos) == 61)) {
                    pos = (pos + 1)
                    this.skipSpace()
                    if (pos < len) {
                        def q:int (charAt src pos)
                        if ((q == 34) || (q == 39)) {
                            def ve:int (indexOfFrom src (strfromcode q) (pos + 1))
                            if (ve < 0) {
                                pos = len
                                return missing
                            }
                            value = (OoxmlText.decodeEntities((substring src (pos + 1) ve)))
                            pos = (ve + 1)
                        }
                    }
                }
                push node.attrNames an
                push node.attrValues value
            }
        }
        ; content, to the matching end tag
        while ((pos < len) && (aborted == false)) {
            def c:int (charAt src pos)
            if (c == 60) {
                if (((pos + 1) < len) && ((charAt src (pos + 1)) == 47)) {
                    def gt2:int (indexOfFrom src ">" pos)
                    if (gt2 < 0) {
                        pos = len
                    } {
                        pos = (gt2 + 1)
                    }
                    def closed@(optional):OdtNode node
                    return closed
                }
                def n2:int 0
                if ((pos + 1) < len) {
                    n2 = (charAt src (pos + 1))
                }
                if ((n2 == 33) || (n2 == 63)) {
                    if ((indexOfFrom src "<![CDATA[" pos) == pos) {
                        def ce:int (indexOfFrom src "]]>" pos)
                        if (ce < 0) {
                            ce = len
                        }
                        this.addText(node (substring src (pos + 9) ce) false)
                        pos = (ce + 3)
                    } {
                        this.skipMarkup()
                    }
                } {
                    def child@(optional):OdtNode (this.readElement((depth + 1)))
                    if (!null? child) {
                        push node.children (unwrap child)
                    }
                }
            } {
                def ts:int pos
                def lt:int (indexOfFrom src "<" pos)
                if (lt < 0) {
                    lt = len
                }
                pos = lt
                this.addText(node (substring src ts lt) true)
            }
        }
        def unclosed@(optional):OdtNode node
        return unclosed
    }

    fn addText:void (node:OdtNode raw:string decode:boolean) {
        def onlySpace:boolean true
        def i:int 0
        def n:int (strlen raw)
        while (i < n) {
            if ((OdtXmlParser.isSpace((charAt raw i))) == false) {
                onlySpace = false
                i = n
            }
            i = (i + 1)
        }
        if (onlySpace && ((OdtXmlParser.keepsSpace(node.name)) == false)) {
            return
        }
        def t:OdtNode (new OdtNode)
        t.isText = true
        if decode {
            t.text = (OoxmlText.decodeEntities(raw))
        } {
            t.text = raw
        }
        push node.children t
    }
}
