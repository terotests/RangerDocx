; ==============================================================================
; DocxChrome.rgr — the word processor's frame: title bar, ribbon, navigation
; pane and status bar.
; ==============================================================================
;
; `DocxToolbar` is one wrapping strip of icons, the same strip the spreadsheet
; and the slides have. A word processor is read differently: the commands sit
; in named GROUPS (Clipboard, Font, Paragraph, Styles, Editing), the big
; buttons are the ones a page is for, and a group's name sits under it. This
; is that layout, painted with the shared toolbar's icons and text so the
; three editors still draw a bold button the same way.
;
; The model and the geometry live here; `DocxApp` owns the commands, the
; document and the decision of what is pressed.
;
; A button whose command does not exist yet is DRAWN, greyed and inert. The
; ribbon is also the parity checklist: what is grey is what is missing, and a
; button that looks live and does nothing would hide exactly that.
; ==============================================================================

Import "pkg:evg_window/EVGToolbarView.rgr"
Import "pkg:evg/EVGToolbar.rgr"
Import "RichDocument.rgr"

; The colours of the frame. One place, so the frame reads as one design
; rather than as whatever each painter picked.
class DocxChromeTheme {
    def window:EVGColor (EVGColor.rgb(243 244 247))
    def titleBar:EVGColor (EVGColor.rgb(248 249 251))
    def ribbon:EVGColor (EVGColor.rgb(255 255 255))
    def desk:EVGColor (EVGColor.rgb(233 235 240))
    def line:EVGColor (EVGColor.rgb(222 225 231))
    def ink:EVGColor (EVGColor.rgb(32 36 44))
    def dim:EVGColor (EVGColor.rgb(96 104 118))
    def faint:EVGColor (EVGColor.rgb(160 166 178))
    def off:EVGColor (EVGColor.rgb(184 189 199))
    def accent:EVGColor (EVGColor.rgb(47 91 211))
    def accentInk:EVGColor (EVGColor.rgb(255 255 255))
    def accentSoft:EVGColor (EVGColor.rgb(226 233 252))
    def hover:EVGColor (EVGColor.rgb(236 239 245))
    def pressed:EVGColor (EVGColor.rgb(216 226 250))
    def field:EVGColor (EVGColor.rgb(255 255 255))
    def heading:EVGColor (EVGColor.rgb(31 78 121))

    Constructor () {
    }
}

; One button, combo box or style tile on the ribbon.
class RibbonItem {
    def command:string ""
    def arg:string ""
    def label:string ""
    def tip:string ""
    def icon:int 0
    ; Drawn instead of an icon when set: "x2", "Aa", "¶" — marks every suite
    ; draws as type rather than as a picture.
    def glyph:string ""
    ; 0 small icon, 1 large, 2 small with its name beside it, 3 combo box,
    ; 4 style tile.
    def kind:int 0
    def enabled:boolean true
    def pressed:boolean false
    ; What a toggle asks the editor ("bold"), so the app can say whether the
    ; run under the caret has it.
    def toggleOp:string ""
    ; A combo box's text and width.
    def text:string ""
    def fieldW:int 0
    ; A style tile's style id, and how its sample is drawn.
    def styleId:string ""
    def sampleSize:double 13.0
    def sampleBold:boolean false
    def sampleItalic:boolean false
    def sampleColor:string ""
    def x:int 0
    def y:int 0
    def w:int 0
    def h:int 0

    Constructor () {
    }

    fn contains:boolean (px:int py:int) {
        if (w <= 0) {
            return false
        }
        return ((((px >= x) && (px < (x + w))) && (py >= y)) && (py < (y + h)))
    }
}

; A column of the ribbon: one large button, or a stack of rows of small ones.
class RibbonCell {
    def large:boolean false
    ; Item indices into the ribbon's list, row by row; `rowEnds` says where
    ; each row stops.
    def members:[int]
    def rowEnds:[int]
    def x:int 0
    def w:int 0

    Constructor () {
    }
}

class RibbonGroup {
    def name:string ""
    def cells:[RibbonCell]
    def x:int 0
    def w:int 0
    ; How many rows the stacks in this group have: two rows sit lower and
    ; wider apart than three, the way Font and Paragraph do.
    def rows:int 3

    Constructor () {
    }
}

class DocxRibbon {
    def tabs:[string]
    def active:int 1
    def items:[RibbonItem]
    def groups:[RibbonGroup]
    def hot:int -1
    def hotTab:int -1
    ; Geometry, set by `layout`.
    def tabX:[int]
    def tabW:[int]
    def x0:int 0
    def y0:int 0
    def width:int 0
    def tabRowH:int 36
    def bodyH:int 108
    def built:string ""

    Constructor () {
        push tabs "File"
        push tabs "Home"
        push tabs "Insert"
        push tabs "Layout"
        push tabs "References"
        push tabs "Review"
        push tabs "View"
    }

    fn height:int () {
        return (tabRowH + bodyH)
    }

    fn tabName:string () {
        return (itemAt tabs active)
    }

    fn selectTab:void (i:int) {
        if ((i >= 0) && (i < (array_length tabs))) {
            active = i
        }
    }

    fn tabIndex:int (name:string) {
        def i:int 0
        while (i < (array_length tabs)) {
            if ((itemAt tabs i) == name) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    ; --- building a page --------------------------------------------------------
    fn group:void (name:string rows:int) {
        def g:RibbonGroup (new RibbonGroup)
        g.name = name
        g.rows = rows
        push groups g
    }

    fn lastGroup:RibbonGroup () {
        return (itemAt groups ((array_length groups) - 1))
    }

    fn put:int (it:RibbonItem) {
        push items it
        return ((array_length items) - 1)
    }

    fn item:RibbonItem (command:string label:string icon:int) {
        def it:RibbonItem (new RibbonItem)
        it.command = command
        it.label = label
        it.tip = label
        it.icon = icon
        return it
    }

    ; A big button: its own column.
    fn large:RibbonItem (command:string label:string icon:int) {
        def it:RibbonItem (this.item(command label icon))
        it.kind = 1
        def c:RibbonCell (new RibbonCell)
        c.large = true
        push c.members (this.put(it))
        push c.rowEnds (array_length c.members)
        def g:RibbonGroup (this.lastGroup())
        push g.cells c
        return it
    }

    ; A new stack of rows in the current group; `small` and friends fill it.
    fn stack:void () {
        def c:RibbonCell (new RibbonCell)
        def g:RibbonGroup (this.lastGroup())
        push g.cells c
    }

    fn lastCell:RibbonCell () {
        def g:RibbonGroup (this.lastGroup())
        return (itemAt g.cells ((array_length g.cells) - 1))
    }

    ; Ends the row being filled; the next item starts a new one.
    fn row:void () {
        def c:RibbonCell (this.lastCell())
        push c.rowEnds (array_length c.members)
    }

    fn addToRow:RibbonItem (it:RibbonItem) {
        def c:RibbonCell (this.lastCell())
        push c.members (this.put(it))
        return it
    }

    fn small:RibbonItem (command:string tip:string icon:int) {
        def it:RibbonItem (this.item(command tip icon))
        it.kind = 0
        return (this.addToRow(it))
    }

    fn glyphButton:RibbonItem (command:string tip:string glyph:string) {
        def it:RibbonItem (this.item(command tip 0))
        it.glyph = glyph
        it.kind = 0
        return (this.addToRow(it))
    }

    fn labeled:RibbonItem (command:string label:string icon:int) {
        def it:RibbonItem (this.item(command label icon))
        it.kind = 2
        return (this.addToRow(it))
    }

    fn combo:RibbonItem (command:string tip:string w:int) {
        def it:RibbonItem (this.item(command tip 0))
        it.kind = 3
        it.fieldW = w
        return (this.addToRow(it))
    }

    fn tile:RibbonItem (styleId:string label:string size:double bold:boolean italic:boolean color:string) {
        def it:RibbonItem (this.item("format.style" label 0))
        it.kind = 4
        it.arg = styleId
        it.styleId = styleId
        it.sampleSize = size
        it.sampleBold = bold
        it.sampleItalic = italic
        it.sampleColor = color
        def c:RibbonCell (new RibbonCell)
        c.large = true
        push c.members (this.put(it))
        push c.rowEnds (array_length c.members)
        def g:RibbonGroup (this.lastGroup())
        push g.cells c
        return it
    }

    ; Builds the page that is showing. Cheap enough to do on a tab change and
    ; nowhere else; `built` says which page the items are.
    fn build:void () {
        def name:string (this.tabName())
        if (name == built) {
            return
        }
        built = name
        clear items
        clear groups
        hot = -1
        if (name == "File") { this.buildFile() }
        if (name == "Home") { this.buildHome() }
        if (name == "Insert") { this.buildInsert() }
        if (name == "Layout") { this.buildLayout() }
        if (name == "References") { this.buildReferences() }
        if (name == "Review") { this.buildReview() }
        if (name == "View") { this.buildView() }
    }

    fn rebuild:void () {
        built = ""
        this.build()
    }

    fn buildFile:void () {
        this.group("Document" 3)
        this.large("file.open" "Open" (ToolIcon.openFile()))
        this.large("file.save" "Save a copy" (ToolIcon.save()))
        this.large("file.print" "Print" (ToolIcon.printDoc()))
        this.group("Info" 3)
        def a:RibbonItem (this.large("file.properties" "Properties" (ToolIcon.report())))
        a.enabled = false
    }

    fn buildHome:void () {
        this.group("Clipboard" 3)
        this.large("edit.paste" "Paste" (ToolIcon.paste()))
        this.stack()
        this.labeled("edit.cut" "Cut" (ToolIcon.cut()))
        this.row()
        this.labeled("edit.copy" "Copy" (ToolIcon.copy()))
        this.row()
        def fp:RibbonItem (this.labeled("format.painter" "Format" (ToolIcon.paint())))
        fp.enabled = false

        this.group("Font" 2)
        this.stack()
        this.combo("format.font" "Font" 132)
        this.combo("format.size.pick" "Font size" 48)
        this.small("format.size.up" "Grow font" (ToolIcon.sizeUp()))
        this.small("format.size.down" "Shrink font" (ToolIcon.sizeDown()))
        this.glyphButton("format.case" "Change case" "Aa")
        this.small("format.clear" "Clear formatting" (ToolIcon.clearFmt()))
        this.row()
        def b:RibbonItem (this.small("format.bold" "Bold (Ctrl+B)" (ToolIcon.bold())))
        b.toggleOp = "bold"
        def i:RibbonItem (this.small("format.italic" "Italic (Ctrl+I)" (ToolIcon.italic())))
        i.toggleOp = "italic"
        def u:RibbonItem (this.small("format.underline" "Underline (Ctrl+U)" (ToolIcon.underline())))
        u.toggleOp = "underline"
        def s:RibbonItem (this.small("format.strike" "Strikethrough" (ToolIcon.strike())))
        s.toggleOp = "strike"
        def sub:RibbonItem (this.glyphButton("format.subscript" "Subscript (Ctrl+=)" "x₂"))
        sub.toggleOp = "sub"
        def sup:RibbonItem (this.glyphButton("format.superscript" "Superscript (Ctrl+Shift+=)" "x²"))
        sup.toggleOp = "super"
        def hl:RibbonItem (this.small("format.highlight" "Text highlight colour" (ToolIcon.fill())))
        hl.toggleOp = "highlight"
        this.small("format.color" "Font colour" (ToolIcon.textColor()))

        this.group("Paragraph" 2)
        this.stack()
        def bl:RibbonItem (this.small("para.bullets" "Bullets" (ToolIcon.bulletList())))
        bl.enabled = false
        def nl:RibbonItem (this.small("para.numbering" "Numbering" (ToolIcon.numberList())))
        nl.enabled = false
        def ml:RibbonItem (this.small("para.multilevel" "Multilevel list" (ToolIcon.outlineList())))
        ml.enabled = false
        this.small("text.outdent" "Decrease indent" (ToolIcon.indentLess()))
        this.small("text.indent" "Increase indent" (ToolIcon.indentMore()))
        def so:RibbonItem (this.small("para.sort" "Sort" (ToolIcon.sortAsc())))
        so.enabled = false
        def pm:RibbonItem (this.glyphButton("view.marks" "Show paragraph marks" "¶"))
        pm.enabled = false
        this.row()
        def al:RibbonItem (this.small("para.align" "Align left" (ToolIcon.alignLeft())))
        al.arg = "0"
        def ac:RibbonItem (this.small("para.align" "Centre" (ToolIcon.alignCenter())))
        ac.arg = "1"
        def ar:RibbonItem (this.small("para.align" "Align right" (ToolIcon.alignRight())))
        ar.arg = "2"
        def aj:RibbonItem (this.small("para.align" "Justify" (ToolIcon.textJustify())))
        aj.arg = "3"
        def ls:RibbonItem (this.glyphButton("para.spacing" "Line spacing" "↕"))
        ls.enabled = false
        def sh:RibbonItem (this.small("para.shading" "Shading" (ToolIcon.fill())))
        sh.enabled = false
        def bo:RibbonItem (this.small("para.borders" "Borders" (ToolIcon.borderAll())))
        bo.enabled = false

        this.group("Styles" 3)
        this.tile("Normal" "Normal" 13.0 false false "")
        this.tile("NoSpacing" "No Spacing" 13.0 false false "")
        this.tile("Heading1" "Heading 1" 17.0 false false "2F5496")
        this.tile("Title" "Title" 22.0 false false "")
        this.tile("Heading2" "Heading 2" 15.0 false false "2F5496")
        this.tile("Subtitle" "Subtitle" 13.0 false false "5A5A5A")

        this.group("Editing" 3)
        this.stack()
        this.labeled("edit.find" "Find" (ToolIcon.search()))
        this.row()
        def rp:RibbonItem (this.labeled("edit.replace" "Replace" (ToolIcon.formatPaste())))
        rp.enabled = false
        this.row()
        this.labeled("edit.selectAll" "Select all" (ToolIcon.editMode()))

        this.group("Mode" 3)
        this.large("edit.mode" "Editing" (ToolIcon.editMode()))
    }

    fn buildInsert:void () {
        this.group("Pages" 3)
        def pb:RibbonItem (this.large("insert.pageBreak" "Page Break" (ToolIcon.newFile())))
        pb.enabled = false
        this.group("Tables" 3)
        def tb:RibbonItem (this.large("insert.table" "Table" (ToolIcon.borderAll())))
        tb.enabled = false
        this.group("Illustrations" 3)
        def pic:RibbonItem (this.large("insert.picture" "Pictures" (ToolIcon.picture())))
        pic.enabled = false
        def shp:RibbonItem (this.large("insert.shapes" "Shapes" (ToolIcon.shapes())))
        shp.enabled = false
        def ch:RibbonItem (this.large("insert.chart" "Chart" (ToolIcon.chart())))
        ch.enabled = false
        this.group("Links" 3)
        def ln:RibbonItem (this.large("insert.link" "Link" (ToolIcon.link())))
        ln.enabled = false
        this.group("Comments" 3)
        def cm:RibbonItem (this.large("insert.comment" "Comment" (ToolIcon.comment())))
        cm.enabled = false
        this.group("Text" 3)
        def tx:RibbonItem (this.large("insert.textBox" "Text Box" (ToolIcon.textBox())))
        tx.enabled = false
    }

    fn buildLayout:void () {
        this.group("Page Setup" 3)
        def mg:RibbonItem (this.large("layout.margins" "Margins" (ToolIcon.borderOut())))
        mg.enabled = false
        def orr:RibbonItem (this.large("layout.orientation" "Orientation" (ToolIcon.newFile())))
        orr.enabled = false
        def sz:RibbonItem (this.large("layout.size" "Size" (ToolIcon.report())))
        sz.enabled = false
        this.group("Paragraph" 3)
        this.stack()
        this.labeled("text.indent" "Indent more" (ToolIcon.indentMore()))
        this.row()
        this.labeled("text.outdent" "Indent less" (ToolIcon.indentLess()))
        this.group("Arrange" 3)
        def al:RibbonItem (this.large("layout.align" "Align" (ToolIcon.arrangeLeft())))
        al.enabled = false
    }

    fn buildReferences:void () {
        this.group("Table of Contents" 3)
        def toc:RibbonItem (this.large("ref.toc" "Table of Contents" (ToolIcon.outlineList())))
        toc.enabled = false
        this.group("Footnotes" 3)
        def fn:RibbonItem (this.large("ref.footnote" "Insert Footnote" (ToolIcon.comment())))
        fn.enabled = false
    }

    fn buildReview:void () {
        this.group("Proofing" 3)
        def sp:RibbonItem (this.large("review.spelling" "Spelling" (ToolIcon.validate())))
        sp.enabled = false
        this.group("Comments" 3)
        def nc:RibbonItem (this.large("review.comment" "New Comment" (ToolIcon.comment())))
        nc.enabled = false
        this.group("Tracking" 3)
        def tc:RibbonItem (this.large("review.track" "Track Changes" (ToolIcon.editMode())))
        tc.enabled = false
    }

    fn buildView:void () {
        this.group("Views" 3)
        this.large("view.continuous" "Print Layout" (ToolIcon.report()))
        this.group("Show" 3)
        this.stack()
        this.labeled("view.ruler" "Ruler" (ToolIcon.alignLeft()))
        this.row()
        this.labeled("view.nav" "Navigation Pane" (ToolIcon.outlineList()))
        this.group("Zoom" 3)
        this.large("view.zoom.in" "Zoom in" (ToolIcon.sizeUp()))
        this.large("view.zoom.out" "Zoom out" (ToolIcon.sizeDown()))
        this.large("view.zoom.reset" "100%" (ToolIcon.search()))
        this.group("Pages" 3)
        this.stack()
        this.labeled("page.prev" "Previous page" (ToolIcon.navPrev()))
        this.row()
        this.labeled("page.next" "Next page" (ToolIcon.navNext()))
        this.group("Direction" 3)
        this.large("view.rtl" "Right to left" (ToolIcon.textRtl()))
    }

    ; --- geometry ---------------------------------------------------------------
    ; Lays the tab row and the page out from (x, y) across `w`. `measure`
    ; gives the width of a label at a size, which only the painter can answer.
    fn layout:void (x:int y:int w:int view:EVGToolbarView) {
        this.build()
        x0 = x
        y0 = y
        width = w
        clear tabX
        clear tabW
        def tx:int (x + 12)
        def ti:int 0
        while (ti < (array_length tabs)) {
            def nm:string (itemAt tabs ti)
            def tw:int ((to_int (view.ctx.tr.measureWidth(nm 13.0))) + 22)
            push tabX tx
            push tabW tw
            tx = (tx + tw)
            ti = (ti + 1)
        }

        def top:int ((y + tabRowH) + 6)
        def gx:int (x + 10)
        def gi:int 0
        while (gi < (array_length groups)) {
            def g:RibbonGroup (itemAt groups gi)
            g.x = gx
            def cx:int (gx + 6)
            def ci:int 0
            while (ci < (array_length g.cells)) {
                def c:RibbonCell (itemAt g.cells ci)
                c.x = cx
                c.w = (this.layoutCell(c cx top g.rows view))
                cx = ((cx + c.w) + 6)
                ci = (ci + 1)
            }
            def nameW:int ((to_int (view.ctx.tr.measureWidth(g.name 11.0))) + 16)
            def gw:int ((cx - gx) + 2)
            if (gw < nameW) {
                gw = nameW
            }
            g.w = gw
            gx = ((gx + gw) + 9)
            gi = (gi + 1)
        }
    }

    ; One column; answers its width.
    fn layoutCell:int (c:RibbonCell x:int top:int rows:int view:EVGToolbarView) {
        ; The row being filled when the page was built has no end yet.
        def n:int (array_length c.rowEnds)
        if ((n == 0) || ((itemAt c.rowEnds (n - 1)) < (array_length c.members))) {
            push c.rowEnds (array_length c.members)
        }
        def widest:int 0
        def rowStart:int 0
        def r:int 0
        while (r < (array_length c.rowEnds)) {
            def rowEnd:int (itemAt c.rowEnds r)
            def ry:int (top + (r * 25))
            def rh:int 23
            if (rows == 2) {
                ry = ((top + 6) + (r * 32))
                rh = 28
            }
            def rx:int x
            def k:int rowStart
            while (k < rowEnd) {
                def it:RibbonItem (itemAt items (itemAt c.members k))
                if (it.kind == 1) {
                    it.x = rx
                    it.y = top
                    it.h = 72
                    def lw:int ((to_int (view.ctx.tr.measureWidth(it.label 11.5))) + 12)
                    it.w = 52
                    if (lw > it.w) {
                        it.w = lw
                    }
                }
                if (it.kind == 4) {
                    it.x = rx
                    it.y = (top + 2)
                    it.w = 84
                    it.h = 66
                }
                if (it.kind == 0) {
                    it.x = rx
                    it.y = ry
                    it.w = 28
                    it.h = rh
                }
                if (it.kind == 2) {
                    it.x = rx
                    it.y = ry
                    it.h = 23
                    it.w = ((to_int (view.ctx.tr.measureWidth(it.label 12.5))) + 34)
                }
                if (it.kind == 3) {
                    it.x = rx
                    it.y = (ry + 1)
                    it.h = (rh - 2)
                    it.w = it.fieldW
                }
                rx = ((rx + it.w) + 2)
                k = (k + 1)
            }
            if ((rx - x) > widest) {
                widest = (rx - x)
            }
            rowStart = rowEnd
            r = (r + 1)
        }
        if (widest > 0) {
            widest = (widest - 2)
        }
        return widest
    }

    fn hit:int (px:int py:int) {
        def i:int 0
        while (i < (array_length items)) {
            def it:RibbonItem (itemAt items i)
            if (it.contains(px py)) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    fn hitTab:int (px:int py:int) {
        if ((py < y0) || (py >= (y0 + tabRowH))) {
            return -1
        }
        def i:int 0
        while (i < (array_length tabX)) {
            def tx:int (itemAt tabX i)
            if ((px >= tx) && (px < (tx + (itemAt tabW i)))) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    fn at:RibbonItem (i:int) {
        return (itemAt items i)
    }

    fn indexOf:int (command:string arg:string) {
        def i:int 0
        while (i < (array_length items)) {
            def it:RibbonItem (itemAt items i)
            if ((it.command == command) && (it.arg == arg)) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }
}

; A heading in the navigation pane.
class NavEntry {
    def paragraphId:int 0
    def level:int 1
    def text:string ""
    def page:int 0
    def y:int 0
    def h:int 0

    Constructor () {
    }
}

; The pane at the left: the document's headings, its pages, or what a search
; found — the three ways a reader gets around a long document without
; scrolling through it.
class DocxNavPane {
    def visible:boolean true
    def x:int 0
    def y:int 0
    def w:int 280
    def h:int 0
    ; 0 headings, 1 pages, 2 results.
    def mode:int 0
    def query:string ""
    def searchFocused:boolean false
    def entries:[NavEntry]
    def hot:int -1
    def current:int -1
    def scroll:int 0
    def builtRevision:int -1
    def builtMode:int -1
    def builtQuery:string ""
    def builtPages:int -1
    def resultCount:int 0

    Constructor () {
    }

    ; The level of a heading style, or 0 for a paragraph that is not one.
    ; Word's ids are "Heading1".."Heading9"; files written by other tools say
    ; "Heading 1" or "heading 1".
    sfn headingLevel:int (styleId:string) {
        def s:string (to_lowercase styleId)
        def n:int (strlen s)
        if (n < 8) {
            return 0
        }
        if ((substring s 0 7) != "heading") {
            return 0
        }
        def last:int ((charAt s (n - 1)) - 48)
        if ((last >= 1) && (last <= 9)) {
            return last
        }
        return 0
    }

    fn markDirty:void () {
        builtRevision = -1
    }

    ; The entries for the current mode, rebuilt only when the document, the
    ; mode, the query or the page count changed.
    fn refresh:void (doc:RichDocument layout:DocxLayout) {
        def pages:int (layout.pageCount())
        if ((((builtRevision == doc.revision) && (builtMode == mode)) && (builtQuery == query)) && (builtPages == pages)) {
            return
        }
        builtRevision = doc.revision
        builtMode = mode
        builtQuery = query
        builtPages = pages
        clear entries
        hot = -1
        if (mode == 1) {
            def p:int 0
            while (p < pages) {
                def e:NavEntry (new NavEntry)
                e.page = p
                e.text = ("Page " + (to_string (p + 1)))
                e.level = 1
                push entries e
                p = (p + 1)
            }
            return
        }
        def pageOf:[int:int]
        def pi:int 0
        while (pi < pages) {
            def pg:LaidPage (layout.pageAt(pi))
            def li:int 0
            while (li < (array_length pg.lines)) {
                def ln:LaidLine (itemAt pg.lines li)
                if ((has pageOf ln.paraIndex) == false) {
                    set pageOf ln.paraIndex pi
                }
                li = (li + 1)
            }
            pi = (pi + 1)
        }
        def want:string (to_lowercase query)
        resultCount = 0
        def bi:int 0
        while (bi < (array_length doc.blocks)) {
            def b:DocBlock (itemAt doc.blocks bi)
            if (b.kind == (DocBlockKind.para())) {
                def para:Paragraph b.paragraph
                def lvl:int (DocxNavPane.headingLevel(para.styleId))
                def take:boolean false
                if (mode == 0) {
                    take = ((lvl > 0) && ((strlen (trim para.text)) > 0))
                }
                if (mode == 2) {
                    if ((strlen want) > 0) {
                        if ((indexOf (to_lowercase para.text) want) >= 0) {
                            take = true
                            resultCount = (resultCount + 1)
                        }
                    }
                }
                if take {
                    def e:NavEntry (new NavEntry)
                    e.paragraphId = para.id
                    e.level = lvl
                    if (mode == 2) {
                        e.level = 1
                    }
                    e.text = (trim para.text)
                    e.page = 0
                    def pgHit@(optional):int (get pageOf para.id)
                    if (!null? pgHit) {
                        e.page = (unwrap pgHit)
                    }
                    push entries e
                }
            }
            bi = (bi + 1)
        }
    }

    ; Which entry the reader is in: the last one at or before the page they
    ; are looking at (headings), or that page (pages).
    fn settleCurrent:void (page:int caretPid:int) {
        current = -1
        def i:int 0
        while (i < (array_length entries)) {
            def e:NavEntry (itemAt entries i)
            if (mode == 1) {
                if (e.page == page) {
                    current = i
                }
            } {
                if (caretPid > 0) {
                    if (e.paragraphId == caretPid) {
                        current = i
                    }
                }
                if (current < 0) {
                    if (e.page <= page) {
                        current = i
                    }
                }
            }
            i = (i + 1)
        }
    }

    ; --- geometry ---------------------------------------------------------------
    fn searchY:int () {
        return (y + 46)
    }

    fn tabsY:int () {
        return (y + 86)
    }

    fn listY:int () {
        return (y + 126)
    }

    fn closeX:int () {
        return ((x + w) - 40)
    }

    ; 0 nothing, 1 close, 2 search box, 3.. tabs (3 + mode), 10 a list row.
    fn hitPart:int (px:int py:int) {
        if (visible == false) {
            return 0
        }
        if ((px < x) || (px >= (x + w)) || (py < y) || (py >= (y + h))) {
            return 0
        }
        if ((py >= (y + 12)) && (py < (y + 36)) && (px >= (this.closeX()))) {
            return 1
        }
        def sy:int (this.searchY())
        if ((py >= sy) && (py < (sy + 30))) {
            return 2
        }
        def ty:int (this.tabsY())
        if ((py >= ty) && (py < (ty + 28))) {
            def k:int (this.tabAtX(px))
            if (k >= 0) {
                return (3 + k)
            }
            return 0
        }
        if (py >= (this.listY())) {
            return 10
        }
        return 0
    }

    fn tabLeft:int (k:int) {
        if (k == 0) { return (x + 16) }
        if (k == 1) { return (x + 104) }
        return (x + 172)
    }

    fn tabWidth:int (k:int) {
        if (k == 0) { return 82 }
        if (k == 1) { return 62 }
        return 72
    }

    fn tabAtX:int (px:int) {
        def k:int 0
        while (k < 3) {
            def l:int (this.tabLeft(k))
            if ((px >= l) && (px < (l + (this.tabWidth(k))))) {
                return k
            }
            k = (k + 1)
        }
        return -1
    }

    fn entryAt:int (py:int) {
        def i:int 0
        while (i < (array_length entries)) {
            def e:NavEntry (itemAt entries i)
            if ((e.h > 0) && (py >= e.y) && (py < (e.y + e.h))) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }
}

; Draws the frame's parts. Holds the shared toolbar painter for its icons and
; its text, so a glyph here is the glyph the other editors draw.
class DocxChromePainter {
    def view:EVGToolbarView (new EVGToolbarView)
    def theme:DocxChromeTheme (new DocxChromeTheme)
    def offTheme:EVGToolbarTheme (new EVGToolbarTheme)
    def onTheme:EVGToolbarTheme (new EVGToolbarTheme)

    Constructor () {
        offTheme.ink = (EVGColor.rgb(184 189 199))
        offTheme.glyphInk = (EVGColor.rgb(184 189 199))
        offTheme.dim = (EVGColor.rgb(196 200 208))
        offTheme.glyph = (EVGColor.rgb(206 210 218))
        offTheme.accent = (EVGColor.rgb(178 190 220))
        offTheme.warn = (EVGColor.rgb(226 180 178))
        offTheme.link = (EVGColor.rgb(178 190 220))
    }

    fn attach:void (ctx:UIContext) {
        view.attach(ctx "Open Sans")
    }

    ; --- primitives -------------------------------------------------------------
    fn rect:void (dl:EVGDisplayList x:int y:int w:int h:int col:EVGColor) {
        dl.addRect((to_double x) (to_double y) (to_double w) (to_double h) col)
    }

    ; A rectangle with rounded corners, as a polygon: the display list has no
    ; rounded rectangle of its own and the frame is made of them.
    fn round:void (dl:EVGDisplayList x:int y:int w:int h:int r:int col:EVGColor) {
        def pts:[double] (DocxChromePainter.roundPts((to_double x) (to_double y) (to_double w) (to_double h) (to_double r)))
        dl.addPolygon(pts col)
    }

    fn roundFrame:void (dl:EVGDisplayList x:int y:int w:int h:int r:int col:EVGColor) {
        def pts:[double] (DocxChromePainter.roundPts(((to_double x) + 0.5) ((to_double y) + 0.5) ((to_double w) - 1.0) ((to_double h) - 1.0) (to_double r)))
        push pts (itemAt pts 0)
        push pts (itemAt pts 1)
        dl.addPolyline(pts 1.0 col)
    }

    sfn roundPts:[double] (x:double y:double w:double h:double r0:double) {
        def pts:[double]
        def r:double r0
        if (r > (w / 2.0)) { r = (w / 2.0) }
        if (r > (h / 2.0)) { r = (h / 2.0) }
        ; Four quarter circles, five points each, clockwise from the top left.
        def cxs:[double]
        push cxs ((x + w) - r)
        push cxs ((x + w) - r)
        push cxs (x + r)
        push cxs (x + r)
        def cys:[double]
        push cys (y + r)
        push cys ((y + h) - r)
        push cys ((y + h) - r)
        push cys (y + r)
        def q:int 0
        while (q < 4) {
            def s:int 0
            while (s <= 4) {
                def a:double (((to_double ((q * 4) + s)) - 4.0) * (3.14159265 / 8.0))
                push pts ((itemAt cxs q) + (r * (cos a)))
                push pts ((itemAt cys q) + (r * (sin a)))
                s = (s + 1)
            }
            q = (q + 1)
        }
        return pts
    }

    fn textW:double (s:string size:double) {
        return (view.ctx.tr.measureWidth(s size))
    }

    ; Text with its top at y.
    fn text:void (dl:EVGDisplayList s:string x:int y:int size:double col:EVGColor bold:boolean) {
        view.pushStyledText(dl s (to_double x) (to_double y) size col "" bold false)
    }

    ; Text centred on (cx, cy).
    fn textMid:void (dl:EVGDisplayList s:string cx:int cy:int size:double col:EVGColor bold:boolean) {
        view.pushToolText(dl s cx cy size col bold)
    }

    fn icon:void (dl:EVGDisplayList k:int cx:int cy:int size:int enabled:boolean) {
        def t:ToolItem (new ToolItem)
        t.icon = k
        t.x = (cx - 14)
        t.y = (cy - 14)
        t.w = 28
        t.h = 28
        view.glyphSize = size
        if enabled {
            view.theme = onTheme
        } {
            view.theme = offTheme
        }
        view.paintToolIcon(dl t 28)
        view.theme = onTheme
        view.glyphSize = 24
    }

    fn chevron:void (dl:EVGDisplayList cx:int cy:int col:EVGColor) {
        def pts:[double]
        push pts ((to_double cx) - 3.5)
        push pts ((to_double cy) - 1.5)
        push pts (to_double cx)
        push pts ((to_double cy) + 2.0)
        push pts ((to_double cx) + 3.5)
        push pts ((to_double cy) - 1.5)
        dl.addPolyline(pts 1.3 col)
    }

    ; --- the title bar ----------------------------------------------------------
    fn paintTitleBar:void (dl:EVGDisplayList w:int h:int title:string dirty:boolean searchHot:boolean) {
        this.rect(dl 0 0 w h theme.titleBar)
        ; The program's mark: a page with a fold, in the accent colour.
        this.round(dl 12 9 26 26 6 theme.accent)
        this.textMid(dl "R" 25 22 14.0 theme.accentInk true)
        ; Quick access: save, undo, redo.
        this.icon(dl (ToolIcon.save()) 62 22 18 true)
        this.icon(dl (ToolIcon.undo()) 92 22 18 true)
        this.icon(dl (ToolIcon.redo()) 122 22 18 true)
        ; The document's name, and whether it has changed since it was opened.
        def t:string title
        if ((strlen t) == 0) {
            t = "Document"
        }
        def state:string "Saved"
        if dirty {
            state = "Edited"
        }
        def full:string (t + "  ·  " + state)
        def tw:int (to_int (this.textW(full 13.0)))
        def tx:int (idiv (w - tw) 2)
        if (tx < 150) {
            tx = 150
        }
        this.text(dl t tx 14 13.0 theme.ink true)
        def nameW:int (to_int (this.textW(t 13.0)))
        this.text(dl ("  ·  " + state) (tx + nameW) 14 13.0 theme.dim false)
        ; The search field, on the right: it searches the document.
        def sw:int 260
        def sx:int ((w - sw) - 150)
        if (sx > (tx + tw + 24)) {
            if searchHot {
                this.round(dl sx 8 sw 28 8 theme.hover)
            } {
                this.round(dl sx 8 sw 28 8 theme.field)
            }
            this.roundFrame(dl sx 8 sw 28 8 theme.line)
            this.icon(dl (ToolIcon.search()) (sx + 16) 22 15 true)
            this.text(dl "Search in document" (sx + 30) 15 12.5 theme.faint false)
        }
        ; Save, as the one coloured button: the thing a person in a browser
        ; needs to do before closing the tab.
        this.round(dl ((w - 120) - 12) 8 120 28 8 theme.accent)
        this.textMid(dl "Download" ((w - 60) - 12) 22 13.0 theme.accentInk true)
        this.rect(dl 0 (h - 1) w 1 theme.line)
    }

    ; --- the ribbon ---------------------------------------------------------------
    fn paintRibbon:void (dl:EVGDisplayList rb:DocxRibbon editing:boolean) {
        def x0:int rb.x0
        def y0:int rb.y0
        def w:int rb.width
        this.rect(dl x0 y0 w rb.tabRowH theme.titleBar)
        def ti:int 0
        while (ti < (array_length rb.tabs)) {
            def tx:int (itemAt rb.tabX ti)
            def tw:int (itemAt rb.tabW ti)
            def nm:string (itemAt rb.tabs ti)
            def on:boolean (ti == rb.active)
            if ((rb.hotTab == ti) && (on == false)) {
                this.round(dl (tx + 2) (y0 + 5) (tw - 4) 26 6 theme.hover)
            }
            def col:EVGColor theme.ink
            if on {
                col = theme.accent
            }
            this.textMid(dl nm (tx + (idiv tw 2)) (y0 + 18) 13.0 col on)
            if on {
                this.round(dl (tx + 8) ((y0 + rb.tabRowH) - 4) (tw - 16) 3 1 theme.accent)
            }
            ti = (ti + 1)
        }
        ; The editing switch at the right end of the tab row, as Word puts it.
        def pillW:int 104
        def px:int ((x0 + w) - (pillW + 14))
        this.roundFrame(dl px (y0 + 5) pillW 26 6 theme.line)
        def mode:string "Viewing"
        if editing {
            mode = "Editing"
        }
        this.icon(dl (ToolIcon.editMode()) (px + 16) (y0 + 18) 14 true)
        this.text(dl mode (px + 30) (y0 + 10) 12.5 theme.ink false)
        this.chevron(dl ((px + pillW) - 14) (y0 + 18) theme.dim)

        ; The page of commands, on a white card with a hairline round it.
        def by:int (y0 + rb.tabRowH)
        this.rect(dl x0 by w rb.bodyH theme.window)
        this.round(dl (x0 + 6) (by + 2) (w - 12) (rb.bodyH - 8) 10 theme.ribbon)
        this.roundFrame(dl (x0 + 6) (by + 2) (w - 12) (rb.bodyH - 8) 10 theme.line)
        def gi:int 0
        while (gi < (array_length rb.groups)) {
            def g:RibbonGroup (itemAt rb.groups gi)
            if ((g.x + g.w) <= ((x0 + w) - 8)) {
                this.textMid(dl g.name (g.x + (idiv g.w 2)) ((by + rb.bodyH) - 15) 11.0 theme.faint false)
                if (gi < ((array_length rb.groups) - 1)) {
                    this.rect(dl ((g.x + g.w) + 4) (by + 10) 1 (rb.bodyH - 24) theme.line)
                }
            }
            gi = (gi + 1)
        }
        def i:int 0
        while (i < (array_length rb.items)) {
            def it:RibbonItem (itemAt rb.items i)
            if ((it.x + it.w) <= ((x0 + w) - 8)) {
                this.paintItem(dl it (i == rb.hot))
            }
            i = (i + 1)
        }
        this.rect(dl x0 ((by + rb.bodyH) - 1) w 1 theme.line)
    }

    fn paintItem:void (dl:EVGDisplayList it:RibbonItem hot:boolean) {
        def ink:EVGColor theme.ink
        if (it.enabled == false) {
            ink = theme.off
        }
        if (it.kind == 3) {
            this.round(dl it.x it.y it.w it.h 5 theme.field)
            def edge:EVGColor theme.line
            if (hot && it.enabled) {
                edge = theme.accent
            }
            this.roundFrame(dl it.x it.y it.w it.h 5 edge)
            this.text(dl it.text (it.x + 7) (it.y + 5) 12.5 ink false)
            this.chevron(dl ((it.x + it.w) - 10) (it.y + (idiv it.h 2)) theme.dim)
            return
        }
        if (it.kind == 4) {
            if it.pressed {
                this.round(dl it.x it.y it.w it.h 6 theme.accentSoft)
                this.roundFrame(dl it.x it.y it.w it.h 6 theme.accent)
            } {
                if hot {
                    this.round(dl it.x it.y it.w it.h 6 theme.hover)
                }
            }
            def col:EVGColor ink
            if ((strlen it.sampleColor) > 0) {
                col = (EVGColor.parseHex(it.sampleColor))
            }
            def sample:string "AaBbCc"
            def sz:double it.sampleSize
            def sw:int (to_int (this.textW(sample sz)))
            while ((sw > (it.w - 10)) && (sz > 9.0)) {
                sz = (sz - 1.0)
                sw = (to_int (this.textW(sample sz)))
            }
            view.pushStyledText(dl sample (to_double ((it.x + (idiv it.w 2)) - (idiv sw 2))) (to_double ((it.y + 24) - (to_int (sz * 0.7)))) sz col "" it.sampleBold it.sampleItalic)
            this.textMid(dl it.label (it.x + (idiv it.w 2)) ((it.y + it.h) - 12) 11.5 theme.dim false)
            return
        }
        if it.pressed {
            this.round(dl it.x it.y it.w it.h 5 theme.pressed)
        } {
            if (hot && it.enabled) {
                this.round(dl it.x it.y it.w it.h 5 theme.hover)
            }
        }
        if (it.kind == 1) {
            def cx:int (it.x + (idiv it.w 2))
            this.icon(dl it.icon cx (it.y + 22) 30 it.enabled)
            this.textMid(dl it.label cx (it.y + 56) 11.5 ink false)
            return
        }
        def cy:int (it.y + (idiv it.h 2))
        if ((strlen it.glyph) > 0) {
            this.textMid(dl it.glyph (it.x + 14) cy 14.0 ink false)
        } {
            this.icon(dl it.icon (it.x + 14) cy 18 it.enabled)
        }
        if (it.kind == 2) {
            this.text(dl it.label (it.x + 30) (cy - 9) 12.5 ink false)
        }
    }

    ; The name of the hot button, under it.
    fn paintTip:void (dl:EVGDisplayList rb:DocxRibbon W:int) {
        if (rb.hot < 0) {
            return
        }
        def it:RibbonItem (rb.at(rb.hot))
        if ((strlen it.tip) == 0) {
            return
        }
        def tip:string it.tip
        if (it.enabled == false) {
            tip = (tip + " (not yet)")
        }
        def tw:int ((to_int (this.textW(tip 12.0))) + 16)
        def tx:int it.x
        if ((tx + tw) > (W - 4)) {
            tx = ((W - 4) - tw)
        }
        def ty:int ((it.y + it.h) + 6)
        this.round(dl tx ty tw 24 5 (EVGColor.rgb(38 43 54)))
        this.text(dl tip (tx + 8) (ty + 4) 12.0 (EVGColor.rgb(246 248 251)) false)
    }

    ; --- the navigation pane ------------------------------------------------------
    fn paintNav:void (dl:EVGDisplayList nav:DocxNavPane) {
        def x:int nav.x
        def y:int nav.y
        def w:int nav.w
        this.rect(dl x y w nav.h theme.titleBar)
        this.rect(dl ((x + w) - 1) y 1 nav.h theme.line)
        this.text(dl "Navigation" (x + 16) (y + 14) 15.0 theme.ink true)
        ; Close.
        def cx:int ((nav.closeX()) + 14)
        this.textMid(dl "×" cx (y + 24) 16.0 theme.dim false)

        def sy:int (nav.searchY())
        this.round(dl (x + 14) sy (w - 28) 30 7 theme.field)
        def edge:EVGColor theme.line
        if nav.searchFocused {
            edge = theme.accent
        }
        this.roundFrame(dl (x + 14) sy (w - 28) 30 7 edge)
        this.icon(dl (ToolIcon.search()) (x + 30) (sy + 15) 15 true)
        if ((strlen nav.query) == 0) {
            if (nav.searchFocused == false) {
                this.text(dl "Search document" (x + 44) (sy + 7) 12.5 theme.faint false)
            }
        } {
            this.text(dl nav.query (x + 44) (sy + 7) 12.5 theme.ink false)
        }
        if nav.searchFocused {
            def qw:int (to_int (this.textW(nav.query 12.5)))
            this.rect(dl ((x + 45) + qw) (sy + 7) 1 16 theme.ink)
        }

        def ty:int (nav.tabsY())
        def k:int 0
        while (k < 3) {
            def l:int (nav.tabLeft(k))
            def tw:int (nav.tabWidth(k))
            def nm:string "Headings"
            if (k == 1) { nm = "Pages" }
            if (k == 2) { nm = "Results" }
            def on:boolean (k == nav.mode)
            if on {
                this.round(dl l ty tw 28 7 theme.accentSoft)
            }
            def col:EVGColor theme.ink
            if on {
                col = theme.accent
            }
            this.textMid(dl nm (l + (idiv tw 2)) (ty + 14) 13.0 col on)
            k = (k + 1)
        }

        def ly:int (nav.listY())
        this.rect(dl (x + 14) (ly - 8) (w - 28) 1 theme.line)
        dl.addClip((to_double x) (to_double ly) (to_double (w - 1)) (to_double ((y + nav.h) - ly)))
        def rowY:int (ly - nav.scroll)
        def i:int 0
        while (i < (array_length nav.entries)) {
            def e:NavEntry (itemAt nav.entries i)
            def rh:int 30
            e.y = rowY
            e.h = rh
            if (((rowY + rh) >= ly) && (rowY < (y + nav.h))) {
                if (i == nav.current) {
                    this.round(dl (x + 10) rowY (w - 20) rh 6 theme.accentSoft)
                    this.rect(dl (x + 10) (rowY + 6) 3 (rh - 12) theme.accent)
                } {
                    if (i == nav.hot) {
                        this.round(dl (x + 10) rowY (w - 20) rh 6 theme.hover)
                    }
                }
                def indent:int ((e.level - 1) * 16)
                def bold:boolean (e.level == 1)
                if (nav.mode != 0) {
                    bold = false
                }
                def label:string (DocxChromePainter.fit(this e.text 13.0 ((w - 44) - indent)))
                this.text(dl label ((x + 22) + indent) (rowY + 6) 13.0 theme.ink bold)
                if (nav.mode == 2) {
                    def pg:string ("p. " + (to_string (e.page + 1)))
                    def pw:int (to_int (this.textW(pg 11.0)))
                    this.text(dl pg (((x + w) - 20) - pw) (rowY + 8) 11.0 theme.faint false)
                }
            }
            rowY = (rowY + rh)
            i = (i + 1)
        }
        if ((array_length nav.entries) == 0) {
            def empty:string "No headings in this document"
            if (nav.mode == 2) {
                empty = "Type above to search the text"
                if ((strlen nav.query) > 0) {
                    empty = "No results"
                }
            }
            this.text(dl empty (x + 22) (ly + 4) 12.5 theme.faint false)
        }
        dl.addClipEnd()
    }

    ; A label cut to a width, with an ellipsis.
    sfn fit:string (p:DocxChromePainter s:string size:double maxW:int) {
        if ((to_int (p.textW(s size))) <= maxW) {
            return s
        }
        def n:int (strlen s)
        while (n > 1) {
            n = (n - 1)
            def cut:string ((substring s 0 n) + "…")
            if ((to_int (p.textW(cut size))) <= maxW) {
                return cut
            }
        }
        return "…"
    }

    ; --- the vertical ruler -------------------------------------------------------
    ; The page's height in inches down the left of the paper, with the top and
    ; bottom margins shaded the way the horizontal one shades left and right.
    fn paintVRuler:void (dl:EVGDisplayList x:int y:int h:int pageTop:int pageH:int marginT:int marginB:int zoom:double clipTop:int) {
        def w:int 18
        this.rect(dl x y w h theme.window)
        dl.addClip((to_double x) (to_double clipTop) (to_double w) (to_double ((y + h) - clipTop)))
        this.rect(dl (x + 3) pageTop (w - 6) pageH (EVGColor.rgb(214 218 226)))
        def mt:int (to_int ((to_double marginT) * zoom))
        def mb:int (to_int ((to_double marginB) * zoom))
        this.rect(dl (x + 3) (pageTop + mt) (w - 6) ((pageH - mt) - mb) theme.field)
        def unit:double (96.0 * zoom)
        def steps:int (to_int (((to_double pageH) / unit) * 8.0))
        def s:int 1
        while (s < steps) {
            def ty:int ((pageTop + mt) + (to_int (((to_double s) * unit) / 8.0)))
            if (ty < ((pageTop + pageH) - 2)) {
                if ((s % 8) == 0) {
                    this.textMid(dl (to_string (idiv s 8)) (x + 9) ty 9.0 theme.dim false)
                } {
                    def len:int 3
                    if ((s % 4) == 0) {
                        len = 6
                    }
                    this.rect(dl ((x + 9) - (idiv len 2)) ty len 1 theme.faint)
                }
            }
            s = (s + 1)
        }
        dl.addClipEnd()
    }

    ; --- the status bar -----------------------------------------------------------
    fn paintStatus:void (dl:EVGDisplayList y:int w:int h:int left:string zoom:double) {
        this.rect(dl 0 y w h theme.titleBar)
        this.rect(dl 0 y w 1 theme.line)
        this.text(dl left 14 (y + 6) 12.0 theme.dim false)
        ; Zoom: minus, a slider, plus, and the percentage.
        def pct:string ((to_string (to_int ((zoom * 100.0) + 0.5))) + "%")
        def sx:int (this.sliderX(w))
        this.textMid(dl "−" (sx - 14) (y + (idiv h 2)) 14.0 theme.dim false)
        this.rect(dl sx (y + (idiv h 2)) 120 2 theme.faint)
        def k:int (this.sliderKnob(w zoom))
        this.rect(dl (sx + 59) ((y + (idiv h 2)) - 4) 1 10 theme.faint)
        this.round(dl (k - 5) ((y + (idiv h 2)) - 6) 10 14 3 theme.field)
        this.roundFrame(dl (k - 5) ((y + (idiv h 2)) - 6) 10 14 3 theme.dim)
        this.textMid(dl "+" (sx + 134) (y + (idiv h 2)) 14.0 theme.dim false)
        this.text(dl pct (sx + 150) (y + 6) 12.0 theme.dim false)
    }

    fn sliderX:int (w:int) {
        return (w - 220)
    }

    ; The slider is centred on 100%: the left half runs down to a quarter, the
    ; right half up to four times, each half linear.
    fn sliderKnob:int (w:int zoom:double) {
        def t:double 0.0
        if (zoom < 1.0) {
            t = ((zoom - 1.0) / 0.75)
        } {
            t = ((zoom - 1.0) / 3.0)
        }
        if (t < -1.0) { t = -1.0 }
        if (t > 1.0) { t = 1.0 }
        return ((this.sliderX(w)) + 60 + (to_int (t * 60.0)))
    }

    fn zoomAtSlider:double (w:int px:int) {
        def t:double ((to_double ((px - (this.sliderX(w))) - 60)) / 60.0)
        if (t < -1.0) { t = -1.0 }
        if (t > 1.0) { t = 1.0 }
        if (t < 0.0) {
            return (1.0 + (t * 0.75))
        }
        return (1.0 + (t * 3.0))
    }
}
