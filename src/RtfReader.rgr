; SPDX-License-Identifier: AGPL-3.0-or-later

; ==============================================================================
; RtfReader - Rich Text Format (.rtf) → RichDocument
; ==============================================================================
;
; RTF is one stream of control words and groups, so this is a tokenizer and a
; stack of group states rather than a tree walk. Character AND paragraph
; formatting live in the group state (a `}` undoes both); a table row's
; definition does not (`\trowd` starts one, and it lasts until the next).
;
; WHAT IS READ. Text in the ANSI code page (1252) with `\'hh` and `\uN`,
; character formatting (bold, italic, underline, strike, super/subscript,
; size, font, colour, highlight), paragraph alignment / indents / spacing /
; line spacing / page breaks, heading styles by name, lists (`\ls`/`\ilvl`
; against the list table), tables (`\trowd` ... `\cell` ... `\row`, with
; widths, merged cells, cell shading and borders), PNG and JPEG pictures,
; hyperlink fields, the page size and margins, the first header and footer.
;
; WHAT IS NOT. Code pages other than 1252 for `\'hh` (`\uN`, which every
; current writer emits beside it, is read), WMF/EMF pictures, shapes and
; text boxes, footnote bodies, nested tables (their text is kept, flat),
; sections after the first, and annotations.
;
; It lands in `RichDocument`, like the .odt reader, and a save writes a
; fresh .docx.
; ==============================================================================

Import "lib.rs"
Import "pkg:evg/EVGCodepoint.rgr"

; Where the text of a group goes.
class RtfDest {
    sfn body:int () {
        return 0
    }
    sfn skip:int () {
        return 1
    }
    sfn fontTable:int () {
        return 2
    }
    sfn colorTable:int () {
        return 3
    }
    sfn styleSheet:int () {
        return 4
    }
    sfn listText:int () {
        return 5
    }
    sfn fieldInst:int () {
        return 6
    }
    sfn picture:int () {
        return 7
    }
    sfn listTable:int () {
        return 8
    }
    sfn overrideTable:int () {
        return 9
    }
    sfn title:int () {
        return 10
    }
    sfn levelText:int () {
        return 11
    }
}

; A list in the list table, level by level as WordNumbering takes them.
class RtfListDef {
    def firstNfc:int -1
    def specs:[string]

    Constructor () {
    }
}

; Everything a `{` saves and a `}` restores.
class RtfState {
    def dest:int 0
    ; Did this group start its destination? Its `}` finishes it.
    def startsDest:boolean false
    ; 0 body, 1 header, 2 footer: which paragraphs the text joins.
    def target:int 0
    def ucSkip:int 1
    ; character
    def bold:boolean false
    def italic:boolean false
    def underline:boolean false
    def strike:boolean false
    def vertAlign:int 0
    def halfPoints:int 24
    def font:int -1
    def color:int 0
    def highlight:int 0
    def hyperlink:string ""
    ; paragraph
    def align:int 0
    def leftTw:int 0
    def rightTw:int 0
    def firstTw:int 0
    def beforeTw:int 0
    def afterTw:int 0
    def lineTw:int 0
    def lineMult:boolean false
    def inTable:boolean false
    def pageBreakBefore:boolean false
    def style:int 0
    def ls:int 0
    def ilvl:int 0

    Constructor () {
    }

    fn copy:RtfState () {
        def s:RtfState (new RtfState)
        s.dest = dest
        s.target = target
        s.ucSkip = ucSkip
        s.bold = bold
        s.italic = italic
        s.underline = underline
        s.strike = strike
        s.vertAlign = vertAlign
        s.halfPoints = halfPoints
        s.font = font
        s.color = color
        s.highlight = highlight
        s.hyperlink = hyperlink
        s.align = align
        s.leftTw = leftTw
        s.rightTw = rightTw
        s.firstTw = firstTw
        s.beforeTw = beforeTw
        s.afterTw = afterTw
        s.lineTw = lineTw
        s.lineMult = lineMult
        s.inTable = inTable
        s.pageBreakBefore = pageBreakBefore
        s.style = style
        s.ls = ls
        s.ilvl = ilvl
        return s
    }

    fn resetChar:void () {
        bold = false
        italic = false
        underline = false
        strike = false
        vertAlign = 0
        halfPoints = 24
        color = 0
        highlight = 0
    }

    fn resetPara:void () {
        align = 0
        leftTw = 0
        rightTw = 0
        firstTw = 0
        beforeTw = 0
        afterTw = 0
        lineTw = 0
        lineMult = false
        inTable = false
        pageBreakBefore = false
        style = 0
        ls = 0
        ilvl = 0
    }
}

; One cell of the row being defined by `\cellx`.
class RtfCellDef {
    def rightTw:int 0
    def merged:boolean false
    def fill:int 0
    def borderTop:DocTableBorder (DocTableBorder.new_())
    def borderBottom:DocTableBorder (DocTableBorder.new_())
    def borderLeft:DocTableBorder (DocTableBorder.new_())
    def borderRight:DocTableBorder (DocTableBorder.new_())

    Constructor () {
        borderTop.style = "none"
        borderBottom.style = "none"
        borderLeft.style = "none"
        borderRight.style = "none"
    }
}

; Where a finished row's cells end, for the grid the table gets when it ends.
class RtfRowInfo {
    def left:int 0
    def edges:[int]

    Constructor () {
    }
}

class RtfReader {
    def lastError:string ""
    def numbering:WordNumbering (WordNumbering.new_())
    def doc:RichDocument (RichDocument.new_())
    def src:string ""
    def pos:int 0
    def len:int 0
    def st:RtfState (new RtfState)
    def stack:[RtfState]
    def defaultFont:int 0
    def fonts:[int:string]
    def colors:[string]
    def styleNames:[int:string]
    ; text a destination collects until its group or entry ends
    def collected:string ""
    def entryIndex:int 0
    def red:int 0
    def green:int 0
    def blue:int 0
    def colorSet:boolean false
    ; lists: \ls → \listid → first level's \levelnfc
    def listNfc:[int:int]
    def lsToList:[int:int]
    def lsNumId:[int:int]
    def listLevel:int -1
    def firstNfc:int -1
    def levelNfc:int -1
    def levelText:string ""
    def curListDef:RtfListDef (new RtfListDef)
    def listDefs:[int:RtfListDef]
    def pendingListId:int 0
    def lastListText:string ""
    ; the paragraph being written, per target (body, header, footer)
    def cur:[Paragraph]
    def curOpen:[boolean]
    ; tables
    def rowDefs:[RtfCellDef]
    def pendingCell:RtfCellDef (new RtfCellDef)
    def borderSide:int 0
    def table@(optional):DocumentTable
    def rowCells:[DocTableCell]
    def cellParas:[Paragraph]
    def rowHeightTw:int 0
    def rowLeftTw:int 0
    def tableRows:[RtfRowInfo]
    ; pictures
    def picHex:string ""
    def picKind:string ""
    def picW:int 0
    def picH:int 0
    def picGoalW:int 0
    def picGoalH:int 0
    def picScaleX:int 100
    def picScaleY:int 100
    def fieldInst:string ""
    def skipChars:int 0
    def sawHeader:boolean false
    def sawFooter:boolean false
    def curSection:int 0
    def blocksAtSection:int 0
    def pageDefaults:DocSection (DocSection.new_())

    Constructor () {
    }

    sfn isRtf:boolean (bytes:buffer) {
        if ((buffer_length bytes) < 5) {
            return false
        }
        def want:string "{\\rtf"
        def i:int 0
        while (i < 5) {
            if ((buffer_get bytes i) != (charAt want i)) {
                return false
            }
            i = (i + 1)
        }
        return true
    }

    fn readBytes@(optional):RichDocument (data:buffer name:string) {
        lastError = ""
        def missing@(optional):RichDocument
        if ((RtfReader.isRtf(data)) == false) {
            lastError = (name + " is not RTF")
            return missing
        }
        def d:RichDocument (this.readString((buffer_to_string data)))
        if ((strlen d.title) == 0) {
            d.title = name
        }
        def out@(optional):RichDocument d
        return out
    }

    fn readString:RichDocument (text:string) {
        doc = (RichDocument.new_())
        numbering = (WordNumbering.new_())
        src = text
        pos = 0
        len = (strlen text)
        st = (new RtfState)
        curSection = 0
        blocksAtSection = 0
        pageDefaults = (DocSection.new_())
        clear stack
        clear cur
        clear curOpen
        def t:int 0
        while (t < 3) {
            push cur (Paragraph.new_())
            push curOpen false
            t = (t + 1)
        }
        this.run()
        this.endParagraph(false)
        this.closeTable()
        if ((array_length doc.blocks) == 0) {
            def p:Paragraph (doc.addParagraph())
            push p.spans (this.spanNow())
        }
        for doc.paragraphs p2:Paragraph pi {
            if (p2.listNumId > 0) {
                numbering.applyToParagraph(p2)
            }
        }
        return doc
    }

    ; ------------------------------------------------------------------
    ; The tokenizer
    ; ------------------------------------------------------------------

    sfn isLetter:boolean (c:int) {
        return (((c >= 97) && (c <= 122)) || ((c >= 65) && (c <= 90)))
    }

    sfn isDigit:boolean (c:int) {
        return ((c >= 48) && (c <= 57))
    }

    sfn hexVal:int (c:int) {
        if ((c >= 48) && (c <= 57)) {
            return (c - 48)
        }
        if ((c >= 97) && (c <= 102)) {
            return (c - 87)
        }
        if ((c >= 65) && (c <= 70)) {
            return (c - 55)
        }
        return -1
    }

    fn run:void () {
        while (pos < len) {
            def c:int (charAt src pos)
            if (c == 123) {
                push stack st
                st = (st.copy())
                pos = (pos + 1)
            } {
                if (c == 125) {
                    this.endGroup()
                    pos = (pos + 1)
                } {
                    if (c == 92) {
                        this.controlWord()
                    } {
                        if ((c == 10) || (c == 13)) {
                            pos = (pos + 1)
                        } {
                            this.textRun()
                        }
                    }
                }
            }
        }
    }

    ; Plain text up to the next special character, copied as a run.
    fn textRun:void () {
        def start:int pos
        while (pos < len) {
            def c:int (charAt src pos)
            if ((((c == 123) || (c == 125)) || (c == 92)) || ((c == 10) || (c == 13))) {
                break
            }
            if (c >= 128) {
                break
            }
            pos = (pos + 1)
        }
        if (pos > start) {
            def s:string (substring src start pos)
            if (skipChars > 0) {
                def n:int (strlen s)
                if (skipChars >= n) {
                    skipChars = (skipChars - n)
                    return
                }
                s = (substring s skipChars n)
                skipChars = 0
            }
            this.text(s)
            return
        }
        ; A byte above 127 written raw: read as code page 1252.
        def b:int (charAt src pos)
        pos = (pos + 1)
        this.codeUnit(b)
    }

    fn codeUnit:void (b:int) {
        if (skipChars > 0) {
            skipChars = (skipChars - 1)
            return
        }
        this.text((EVGCodepoint.toStr((RtfReader.cp1252(b)))))
    }

    sfn cp1252:int (b:int) {
        if ((b < 128) || (b > 159)) {
            return b
        }
        def map:[int] ([] _:int (8364 129 8218 402 8222 8230 8224 8225 710 8240 352 8249 338 141 381 143 144 8216 8217 8220 8221 8226 8211 8212 732 8482 353 8250 339 157 382 376))
        return (itemAt map (b - 128))
    }

    fn controlWord:void () {
        pos = (pos + 1)
        if (pos >= len) {
            return
        }
        def c:int (charAt src pos)
        if ((RtfReader.isLetter(c)) == false) {
            pos = (pos + 1)
            this.controlSymbol(c)
            return
        }
        def start:int pos
        while ((pos < len) && (RtfReader.isLetter((charAt src pos)))) {
            pos = (pos + 1)
        }
        def word:string (substring src start pos)
        def hasParam:boolean false
        def param:int 0
        def neg:boolean false
        if ((pos < len) && ((charAt src pos) == 45)) {
            if (((pos + 1) < len) && (RtfReader.isDigit((charAt src (pos + 1))))) {
                neg = true
                pos = (pos + 1)
            }
        }
        while ((pos < len) && (RtfReader.isDigit((charAt src pos)))) {
            hasParam = true
            param = ((param * 10) + ((charAt src pos) - 48))
            pos = (pos + 1)
        }
        if neg {
            param = (0 - param)
        }
        if ((pos < len) && ((charAt src pos) == 32)) {
            pos = (pos + 1)
        }
        this.word(word hasParam param)
    }

    fn controlSymbol:void (c:int) {
        ; \'hh
        if (c == 39) {
            if ((pos + 1) < len) {
                def hi:int (RtfReader.hexVal((charAt src pos)))
                def lo:int (RtfReader.hexVal((charAt src (pos + 1))))
                pos = (pos + 2)
                if ((hi >= 0) && (lo >= 0)) {
                    this.codeUnit(((hi * 16) + lo))
                }
            }
            return
        }
        if (((c == 92) || (c == 123)) || (c == 125)) {
            this.text((strfromcode c))
            return
        }
        if (c == 126) {
            this.text((EVGCodepoint.toStr(160)))
            return
        }
        if (c == 95) {
            this.text("-")
            return
        }
        if (c == 42) {
            ; \* : a destination this reader may not know. The word after it
            ; decides; an unknown one is skipped whole.
            this.starDestination()
            return
        }
        if ((c == 10) || (c == 13)) {
            this.word("par" false 0)
            return
        }
    }

    ; After `\*`: the few starred destinations whose content is wanted, and
    ; everything else skipped.
    fn starDestination:void () {
        def save:int pos
        if ((pos < len) && ((charAt src pos) == 92)) {
            def p:int (pos + 1)
            def s:int p
            while ((p < len) && (RtfReader.isLetter((charAt src p)))) {
                p = (p + 1)
            }
            def w:string (substring src s p)
            if (w == "shppict") {
                ; the picture Word writes for a shape: kept, as a plain group
                pos = p
                return
            }
            if (((w == "fldinst") || (w == "listtable")) || (w == "listoverridetable")) {
                return
            }
        }
        pos = save
        this.beginDest((RtfDest.skip()))
    }

    fn beginDest:void (d:int) {
        st.dest = d
        st.startsDest = true
        if (RtfReader.collects(d)) {
            collected = ""
        }
    }

    ; Destinations whose whole text is collected and used at their end.
    sfn collects:boolean (d:int) {
        return ((((d == (RtfDest.listText())) || (d == (RtfDest.fieldInst()))) || (d == (RtfDest.title()))) || (d == (RtfDest.levelText())))
    }

    fn endGroup:void () {
        if (st.startsDest) {
            this.finishDest(st)
        }
        def n:int (array_length stack)
        if (n == 0) {
            return
        }
        def outer:RtfState (itemAt stack (n - 1))
        removeLast stack
        ; A header's paragraph that never got its \par still ends with it.
        if ((st.target != outer.target) && (st.target > 0)) {
            this.endParagraphOf(st.target false)
        }
        st = outer
    }

    fn finishDest:void (s:RtfState) {
        def d:int s.dest
        if (d == (RtfDest.fontTable())) {
            this.endFontEntry()
        }
        if (d == (RtfDest.styleSheet())) {
            this.endStyleEntry()
        }
        if (d == (RtfDest.listText())) {
            lastListText = collected
        }
        if (d == (RtfDest.fieldInst())) {
            fieldInst = collected
        }
        if (d == (RtfDest.picture())) {
            this.endPicture()
        }
        if (d == (RtfDest.title())) {
            doc.title = collected
        }
        if (d == (RtfDest.levelText())) {
            levelText = collected
        }
        if (RtfReader.collects(d)) {
            collected = ""
        }
    }

    ; ------------------------------------------------------------------
    ; Control words
    ; ------------------------------------------------------------------

    fn word:void (w:string has:boolean p:int) {
        def d:int st.dest
        if (d == (RtfDest.skip())) {
            return
        }
        if (this.destinationWord(w)) {
            return
        }
        if (d == (RtfDest.fontTable())) {
            if (w == "f") {
                entryIndex = p
            }
            return
        }
        if (d == (RtfDest.colorTable())) {
            if (w == "red") {
                red = p
                colorSet = true
            }
            if (w == "green") {
                green = p
                colorSet = true
            }
            if (w == "blue") {
                blue = p
                colorSet = true
            }
            return
        }
        if (d == (RtfDest.styleSheet())) {
            if (w == "s") {
                entryIndex = p
            }
            if ((w == "cs") || (w == "ds") || (w == "ts")) {
                entryIndex = -1
            }
            return
        }
        if (d == (RtfDest.listTable())) {
            if (w == "list") {
                listLevel = -1
                firstNfc = -1
                curListDef = (new RtfListDef)
                levelNfc = -1
                levelText = ""
            }
            if (w == "listlevel") {
                this.flushLevel()
                listLevel = (listLevel + 1)
            }
            if ((w == "levelnfc") || (w == "levelnfcn")) {
                levelNfc = p
                if (listLevel == 0) {
                    firstNfc = p
                }
            }
            if (w == "leveltext") {
                this.beginDest((RtfDest.levelText()))
            }
            if (w == "listid") {
                this.flushLevel()
                set listNfc p firstNfc
                curListDef.firstNfc = firstNfc
                set listDefs p curListDef
                curListDef = (new RtfListDef)
                listLevel = -1
            }
            return
        }
        if (d == (RtfDest.levelText())) {
            this.special(w p)
            return
        }
        if (d == (RtfDest.overrideTable())) {
            if (w == "listid") {
                pendingListId = p
            }
            if (w == "ls") {
                set lsToList p pendingListId
            }
            return
        }
        if (d == (RtfDest.picture())) {
            this.pictureWord(w p)
            return
        }
        if ((d == (RtfDest.listText())) || (d == (RtfDest.fieldInst()))) {
            this.special(w p)
            return
        }
        if (d == (RtfDest.title())) {
            this.special(w p)
            return
        }
        this.bodyWord(w has p)
    }

    ; Words that open a destination. True when `w` was one.
    fn destinationWord:boolean (w:string) {
        if (w == "fonttbl") {
            this.beginDest((RtfDest.fontTable()))
            return true
        }
        if (w == "colortbl") {
            this.beginDest((RtfDest.colorTable()))
            red = 0
            green = 0
            blue = 0
            colorSet = false
            return true
        }
        if (w == "stylesheet") {
            this.beginDest((RtfDest.styleSheet()))
            return true
        }
        if (w == "listtable") {
            this.beginDest((RtfDest.listTable()))
            return true
        }
        if (w == "listoverridetable") {
            this.beginDest((RtfDest.overrideTable()))
            return true
        }
        if ((w == "listtext") || (w == "pntext")) {
            this.beginDest((RtfDest.listText()))
            return true
        }
        if (w == "fldinst") {
            this.beginDest((RtfDest.fieldInst()))
            return true
        }
        if (w == "fldrslt") {
            def inst:string (RtfReader.trim(fieldInst))
            if ((indexOf inst "HYPERLINK") == 0) {
                st.hyperlink = (RtfReader.linkOf(inst))
            }
            return true
        }
        if (w == "pict") {
            this.beginDest((RtfDest.picture()))
            picHex = ""
            picKind = ""
            picW = 0
            picH = 0
            picGoalW = 0
            picGoalH = 0
            picScaleX = 100
            picScaleY = 100
            return true
        }
        if (w == "title") {
            this.beginDest((RtfDest.title()))
            return true
        }
        if ((w == "header") || (w == "headerr")) {
            if sawHeader {
                this.beginDest((RtfDest.skip()))
            } {
                sawHeader = true
                def hsec:DocSection (doc.sectionAt(curSection))
                clear hsec.headerParas
                st.target = 1
                st.resetPara()
            }
            return true
        }
        if ((w == "footer") || (w == "footerr")) {
            if sawFooter {
                this.beginDest((RtfDest.skip()))
            } {
                sawFooter = true
                def fsec:DocSection (doc.sectionAt(curSection))
                clear fsec.footerParas
                st.target = 2
                st.resetPara()
            }
            return true
        }
        def skipped:[string] ([] _:string ("info" "headerl" "headerf" "footerl" "footerf" "footnote" "annotation" "nonshppict" "object" "xe" "tc" "bkmkstart" "bkmkend" "author" "operator" "subject" "keywords" "comment" "doccomm" "pn" "shp" "shpinst" "fldtype" "datafield" "template" "revtbl" "rsidtbl" "generator" "filetbl" "pgdsctbl" "colorschememapping" "themedata" "latentstyles" "xmlnstbl" "mmathPr" "falt" "panose" "listpicture"))
        for skipped k:string ki {
            if (k == w) {
                if (w == "info") {
                    ; the title is in here; the rest is not
                    st.dest = (RtfDest.skip())
                    st.startsDest = true
                    this.infoTitle()
                }
                this.beginDest((RtfDest.skip()))
                return true
            }
        }
        return false
    }

    ; `{\info ... {\title X} ...}`: find the title without walking the rest.
    fn infoTitle:void () {
        def at:int (indexOfFrom src "{\\title" pos)
        if (at < 0) {
            return
        }
        def endInfo:int (this.groupEnd(pos))
        if ((endInfo > 0) && (at > endInfo)) {
            return
        }
        def s:int (at + 7)
        def e:int (indexOfFrom src "}" s)
        if (e > s) {
            doc.title = (RtfReader.trim((substring src s e)))
        }
    }

    ; The index of the `}` closing the group `from` is inside.
    fn groupEnd:int (from:int) {
        def depth:int 1
        def i:int from
        while (i < len) {
            def c:int (charAt src i)
            if (c == 92) {
                i = (i + 2)
            } {
                if (c == 123) {
                    depth = (depth + 1)
                }
                if (c == 125) {
                    depth = (depth - 1)
                    if (depth <= 0) {
                        return i
                    }
                }
                i = (i + 1)
            }
        }
        return -1
    }

    ; Character words inside a destination whose text is collected (a
    ; list marker, a field instruction, a title).
    fn special:void (w:string p:int) {
        if (w == "u") {
            this.unicodeChar(p)
            return
        }
        if (w == "uc") {
            st.ucSkip = p
            return
        }
        if ((w == "tab") || (w == "line")) {
            this.text(" ")
            return
        }
        this.namedChar(w)
    }

    fn unicodeChar:void (p:int) {
        def cp:int p
        if (cp < 0) {
            cp = (cp + 65536)
        }
        this.text((EVGCodepoint.toStr(cp)))
        skipChars = st.ucSkip
    }

    ; \bullet, \emdash and the quotes: words that stand for a character.
    fn namedChar:boolean (w:string) {
        def cp:int -1
        if (w == "bullet") {
            cp = 8226
        }
        if (w == "emdash") {
            cp = 8212
        }
        if (w == "endash") {
            cp = 8211
        }
        if (w == "lquote") {
            cp = 8216
        }
        if (w == "rquote") {
            cp = 8217
        }
        if (w == "ldblquote") {
            cp = 8220
        }
        if (w == "rdblquote") {
            cp = 8221
        }
        if (w == "emspace") {
            cp = 8195
        }
        if (w == "enspace") {
            cp = 8194
        }
        if (w == "qmspace") {
            cp = 8197
        }
        if (cp < 0) {
            return false
        }
        this.text((EVGCodepoint.toStr(cp)))
        return true
    }

    fn bodyWord:void (w:string has:boolean p:int) {
        if (w == "par") {
            this.endParagraph(true)
            return
        }
        if (w == "cell") {
            this.endCell()
            return
        }
        if (w == "row") {
            this.endRow()
            return
        }
        if (w == "page") {
            this.endParagraph(false)
            if (st.target == 0) {
                this.closeTable()
                doc.addPageBreak()
            }
            return
        }
        if ((w == "tab") || (w == "line")) {
            this.text(" ")
            return
        }
        if (w == "u") {
            this.unicodeChar(p)
            return
        }
        if (w == "uc") {
            st.ucSkip = p
            return
        }
        if (this.namedChar(w)) {
            return
        }
        ; character formatting
        def on:boolean ((has == false) || (p != 0))
        if (w == "plain") {
            st.resetChar()
            st.font = defaultFont
            return
        }
        if (w == "b") {
            st.bold = on
            return
        }
        if (w == "i") {
            st.italic = on
            return
        }
        if (((w == "ul") || (w == "uld")) || ((w == "uldb") || (w == "ulw"))) {
            st.underline = on
            return
        }
        if (w == "ulnone") {
            st.underline = false
            return
        }
        if ((w == "strike") || (w == "striked")) {
            st.strike = on
            return
        }
        if (w == "super") {
            st.vertAlign = 1
            return
        }
        if (w == "sub") {
            st.vertAlign = 2
            return
        }
        if (w == "nosupersub") {
            st.vertAlign = 0
            return
        }
        if (w == "fs") {
            if (p > 0) {
                st.halfPoints = p
            }
            return
        }
        if (w == "f") {
            st.font = p
            return
        }
        if (w == "cf") {
            st.color = p
            return
        }
        if ((w == "highlight") || (w == "cb")) {
            st.highlight = p
            return
        }
        ; paragraph formatting
        if (w == "pard") {
            st.resetPara()
            return
        }
        if (w == "ql") {
            st.align = 0
            return
        }
        if (w == "qc") {
            st.align = 1
            return
        }
        if (w == "qr") {
            st.align = 2
            return
        }
        if (w == "qj") {
            st.align = 3
            return
        }
        if ((w == "li") || (w == "lin")) {
            st.leftTw = p
            return
        }
        if ((w == "ri") || (w == "rin")) {
            st.rightTw = p
            return
        }
        if (w == "fi") {
            st.firstTw = p
            return
        }
        if (w == "sb") {
            st.beforeTw = p
            return
        }
        if (w == "sa") {
            st.afterTw = p
            return
        }
        if (w == "sl") {
            st.lineTw = p
            return
        }
        if (w == "slmult") {
            st.lineMult = (p == 1)
            return
        }
        if (w == "intbl") {
            st.inTable = true
            return
        }
        if (w == "pagebb") {
            st.pageBreakBefore = true
            return
        }
        if (w == "s") {
            st.style = p
            return
        }
        if (w == "ls") {
            st.ls = p
            return
        }
        if (w == "ilvl") {
            st.ilvl = p
            return
        }
        if (w == "deff") {
            defaultFont = p
            st.font = p
            return
        }
        this.tableWord(w p)
        this.pageWord(w p)
    }

    fn tableWord:void (w:string p:int) {
        if (w == "trowd") {
            clear rowDefs
            pendingCell = (new RtfCellDef)
            borderSide = 0
            rowHeightTw = 0
            rowLeftTw = 0
            return
        }
        if (w == "trleft") {
            rowLeftTw = p
            return
        }
        if (w == "trrh") {
            if (p < 0) {
                rowHeightTw = (0 - p)
            } {
                rowHeightTw = p
            }
            return
        }
        if (w == "cellx") {
            pendingCell.rightTw = p
            push rowDefs pendingCell
            pendingCell = (new RtfCellDef)
            borderSide = 0
            return
        }
        if (w == "clmrg") {
            pendingCell.merged = true
            return
        }
        if (w == "clcbpat") {
            pendingCell.fill = p
            return
        }
        if (w == "clbrdrt") {
            borderSide = 1
            pendingCell.borderTop.style = "single"
            return
        }
        if (w == "clbrdrb") {
            borderSide = 2
            pendingCell.borderBottom.style = "single"
            return
        }
        if (w == "clbrdrl") {
            borderSide = 3
            pendingCell.borderLeft.style = "single"
            return
        }
        if (w == "clbrdrr") {
            borderSide = 4
            pendingCell.borderRight.style = "single"
            return
        }
        if (borderSide > 0) {
            def b:DocTableBorder (this.sideBorder())
            if ((w == "brdrnone") || (w == "brdrnil")) {
                b.style = "none"
            }
            if (w == "brdrdb") {
                b.style = "double"
            }
            if (w == "brdrdot") {
                b.style = "dotted"
            }
            if (w == "brdrdash") {
                b.style = "dashed"
            }
            if (w == "brdrw") {
                ; twips → eighths of a point
                def sz:int (idiv ((p * 2) + 2) 5)
                if (sz < 2) {
                    sz = 2
                }
                b.sz = sz
            }
            if (w == "brdrcf") {
                def hex:string (this.colorHex(p))
                if ((strlen hex) == 6) {
                    b.colorHex = hex
                }
            }
        }
    }

    fn sideBorder:DocTableBorder () {
        if (borderSide == 1) {
            return pendingCell.borderTop
        }
        if (borderSide == 2) {
            return pendingCell.borderBottom
        }
        if (borderSide == 3) {
            return pendingCell.borderLeft
        }
        return pendingCell.borderRight
    }

    ; Page words. The document's (\paperw) are every section's default; a
    ; section's own (\pgwsxn) are for the section being read.
    fn pageWord:void (w:string p:int) {
        def sec:DocSection (doc.sectionAt(curSection))
        def isDoc:boolean false
        if ((w == "paperw") || (w == "pgwsxn")) {
            sec.pageWTwips = p
            isDoc = (w == "paperw")
        }
        if ((w == "paperh") || (w == "pghsxn")) {
            sec.pageHTwips = p
            isDoc = (w == "paperh")
        }
        if ((w == "margl") || (w == "marglsxn")) {
            sec.marginLeftTwips = p
            isDoc = (w == "margl")
        }
        if ((w == "margr") || (w == "margrsxn")) {
            sec.marginRightTwips = p
            isDoc = (w == "margr")
        }
        if ((w == "margt") || (w == "margtsxn")) {
            sec.marginTopTwips = p
            isDoc = (w == "margt")
        }
        if ((w == "margb") || (w == "margbsxn")) {
            sec.marginBottomTwips = p
            isDoc = (w == "margb")
        }
        if ((w == "landscape") || (w == "lndscpsxn")) {
            sec.landscape = true
            isDoc = (w == "landscape")
        }
        if isDoc {
            RtfReader.copyPage(sec pageDefaults)
        }
        if (w == "sect") {
            this.endParagraph(false)
            this.closeTable()
            this.newSection()
        }
    }

    sfn copyPage:void (from:DocSection to:DocSection) {
        to.pageWTwips = from.pageWTwips
        to.pageHTwips = from.pageHTwips
        to.marginTopTwips = from.marginTopTwips
        to.marginBottomTwips = from.marginBottomTwips
        to.marginLeftTwips = from.marginLeftTwips
        to.marginRightTwips = from.marginRightTwips
        to.landscape = from.landscape
    }

    ; A \sect. Nothing written since the last one is not a section, and a
    ; page break just before it is the same page break.
    fn newSection:void () {
        def n:int (array_length doc.blocks)
        if (n == blocksAtSection) {
            return
        }
        if (n > 0) {
            def last:DocBlock (itemAt doc.blocks (n - 1))
            if (last.kind == (DocBlockKind.pageBreak())) {
                removeLast doc.blocks
            }
        }
        def prevSec:DocSection (doc.sectionAt(curSection))
        curSection = (doc.addSectionBreak())
        def sec:DocSection (doc.sectionAt(curSection))
        RtfReader.copyPage(pageDefaults sec)
        ; a section with no header of its own shows the one before it
        for prevSec.headerParas hp:Paragraph hpi {
            push sec.headerParas hp
        }
        for prevSec.footerParas fp:Paragraph fpi {
            push sec.footerParas fp
        }
        sawHeader = false
        sawFooter = false
        blocksAtSection = (array_length doc.blocks)
    }

    fn pictureWord:void (w:string p:int) {
        if (w == "pngblip") {
            picKind = "png"
        }
        if (w == "jpegblip") {
            picKind = "jpeg"
        }
        if (w == "picw") {
            picW = p
        }
        if (w == "pich") {
            picH = p
        }
        if (w == "picwgoal") {
            picGoalW = p
        }
        if (w == "pichgoal") {
            picGoalH = p
        }
        if (w == "picscalex") {
            picScaleX = p
        }
        if (w == "picscaley") {
            picScaleY = p
        }
        if (w == "bin") {
            ; raw binary of `p` bytes: rare, and not hex, so it is stepped over
            pos = (pos + p)
        }
    }

    ; ------------------------------------------------------------------
    ; Text
    ; ------------------------------------------------------------------

    fn text:void (s:string) {
        def d:int st.dest
        if (d == (RtfDest.body())) {
            this.bodyText(s)
            return
        }
        if (d == (RtfDest.picture())) {
            picHex = (picHex + s)
            return
        }
        if ((((d == (RtfDest.fontTable())) || (d == (RtfDest.styleSheet()))) || ((d == (RtfDest.listText())) || (d == (RtfDest.fieldInst())))) || ((d == (RtfDest.title())) || (d == (RtfDest.levelText())))) {
            collected = (collected + s)
            if ((d == (RtfDest.fontTable())) || (d == (RtfDest.styleSheet()))) {
                if ((indexOf collected ";") >= 0) {
                    if (d == (RtfDest.fontTable())) {
                        this.endFontEntry()
                    } {
                        this.endStyleEntry()
                    }
                }
            }
            return
        }
        if (d == (RtfDest.colorTable())) {
            ; each `;` ends an entry; the first, empty one is "auto"
            def n:int (strlen s)
            def i:int 0
            while (i < n) {
                if ((charAt s i) == 59) {
                    if colorSet {
                        push colors ((RtfReader.hex2(red)) + (RtfReader.hex2(green)) + (RtfReader.hex2(blue)))
                    } {
                        push colors ""
                    }
                    red = 0
                    green = 0
                    blue = 0
                    colorSet = false
                }
                i = (i + 1)
            }
        }
    }

    sfn hex2:string (v:int) {
        def digits:string "0123456789ABCDEF"
        def hi:int (idiv v 16)
        def lo:int (v - (hi * 16))
        return ((substring digits hi (hi + 1)) + (substring digits lo (lo + 1)))
    }

    fn colorHex:string (idx:int) {
        if ((idx < 0) || (idx >= (array_length colors))) {
            return ""
        }
        return (itemAt colors idx)
    }

    fn endFontEntry:void () {
        def name:string collected
        def semi:int (indexOf name ";")
        if (semi >= 0) {
            name = (substring name 0 semi)
        }
        name = (RtfReader.trim(name))
        if ((strlen name) > 0) {
            set fonts entryIndex name
        }
        collected = ""
    }

    fn endStyleEntry:void () {
        def name:string collected
        def semi:int (indexOf name ";")
        if (semi >= 0) {
            name = (substring name 0 semi)
        }
        name = (RtfReader.trim(name))
        if (((strlen name) > 0) && (entryIndex >= 0)) {
            set styleNames entryIndex name
        }
        entryIndex = 0
        collected = ""
    }

    sfn trim:string (s:string) {
        def a:int 0
        def b:int (strlen s)
        while ((a < b) && ((charAt s a) <= 32)) {
            a = (a + 1)
        }
        while ((b > a) && ((charAt s (b - 1)) <= 32)) {
            b = (b - 1)
        }
        return (substring s a b)
    }

    ; HYPERLINK "https://…" → https://…
    sfn linkOf:string (inst:string) {
        def q:int (indexOf inst "\"")
        if (q >= 0) {
            def e:int (indexOfFrom inst "\"" (q + 1))
            if (e > q) {
                return (substring inst (q + 1) e)
            }
        }
        return (RtfReader.trim((substring inst 9 (strlen inst))))
    }

    fn spanNow:TextSpan () {
        def s:TextSpan (TextSpan.create(0 0))
        s.bold = st.bold
        s.italic = st.italic
        s.underline = st.underline
        s.strike = st.strike
        s.vertAlign = st.vertAlign
        s.fontSizePt = ((to_double st.halfPoints) / 2.0)
        def fam@(optional):string (get fonts st.font)
        if (!null? fam) {
            s.fontFamily = (WordStyleResolver.mapFont((unwrap fam)))
        } {
            s.fontFamily = (WordStyleResolver.mapFont("Times New Roman"))
        }
        def col:string (this.colorHex(st.color))
        if ((strlen col) == 6) {
            s.colorHex = col
        }
        if (st.highlight > 0) {
            s.highlight = (OdtReader.highlightOf((this.colorHex(st.highlight))))
        }
        s.hyperlink = st.hyperlink
        return s
    }

    fn bodyText:void (s:string) {
        def t:int st.target
        if ((itemAt curOpen t) == false) {
            this.openParagraph(t)
        }
        def p:Paragraph (itemAt cur t)
        p.appendText(s (this.spanNow()))
    }

    fn openParagraph:void (t:int) {
        def p:Paragraph (Paragraph.new_())
        clear p.spans
        set cur t p
        set curOpen t true
    }

    ; ------------------------------------------------------------------
    ; Paragraphs
    ; ------------------------------------------------------------------

    fn endParagraph:void (explicit:boolean) {
        this.endParagraphOf(st.target explicit)
    }

    ; `explicit`: a \par, which ends a paragraph even when it is empty.
    fn endParagraphOf:void (t:int explicit:boolean) {
        def open:boolean (itemAt curOpen t)
        if ((open == false) && (explicit == false)) {
            return
        }
        if (open == false) {
            this.openParagraph(t)
        }
        def p:Paragraph (itemAt cur t)
        set curOpen t false
        this.formatParagraph(p)
        if ((array_length p.spans) == 0) {
            push p.spans (this.spanNow())
        }
        def sec:DocSection (doc.sectionAt(curSection))
        if (t == 1) {
            this.adopt(p)
            push sec.headerParas p
            return
        }
        if (t == 2) {
            this.adopt(p)
            push sec.footerParas p
            return
        }
        if st.inTable {
            this.adopt(p)
            push cellParas p
            return
        }
        this.closeTable()
        if (p.pageBreakBefore && ((array_length doc.blocks) > 0)) {
            doc.addPageBreak()
        }
        p.id = doc.nextParaId
        doc.nextParaId = (doc.nextParaId + 1)
        push doc.paragraphs p
        push doc.blocks (DocBlock.para(p))
    }

    ; A paragraph that is not a block of its own still gets an id.
    fn adopt:void (p:Paragraph) {
        p.id = doc.nextParaId
        doc.nextParaId = (doc.nextParaId + 1)
        push doc.paragraphs p
    }

    fn formatParagraph:void (p:Paragraph) {
        p.align = st.align
        p.indentLeftPt = ((to_double st.leftTw) / 20.0)
        p.indentRightPt = ((to_double st.rightTw) / 20.0)
        p.indentFirstLinePt = ((to_double st.firstTw) / 20.0)
        p.spaceBeforePt = ((to_double st.beforeTw) / 20.0)
        p.spaceAfterPt = ((to_double st.afterTw) / 20.0)
        p.lineSpacing = 1.0
        if (st.lineMult && (st.lineTw > 0)) {
            p.lineSpacing = ((to_double st.lineTw) / 240.0)
        }
        p.pageBreakBefore = st.pageBreakBefore
        p.styleId = (this.styleIdOf(st.style))
        if (st.ls > 0) {
            def id:int (this.numIdFor(st.ls))
            if (id > 0) {
                p.listNumId = id
                p.listLevel = st.ilvl
            }
        }
        lastListText = ""
    }

    fn styleIdOf:string (idx:int) {
        def name@(optional):string (get styleNames idx)
        if (null? name) {
            return "Normal"
        }
        def n:string (to_lowercase (unwrap name))
        if ((indexOf n "heading ") == 0) {
            def lv@(optional):int (str2int (substring n 8 (strlen n)))
            if (!null? lv) {
                return ("Heading" + (to_string (unwrap lv)))
            }
        }
        if (n == "title") {
            return "Title"
        }
        if (n == "subtitle") {
            return "Subtitle"
        }
        return "Normal"
    }

    ; The level just read into the list being defined.
    fn flushLevel:void () {
        if (listLevel >= 0) {
            push curListDef.specs (RtfReader.levelSpec(levelNfc levelText listLevel))
        }
        levelNfc = -1
        levelText = ""
    }

    ; `\levelnfc` and `\leveltext` as WordNumbering's "format:text". The
    ; level text is Word's own encoding: a length, then the text, where a
    ; character below 9 stands for that level's number.
    sfn levelSpec:string (nfc:int lt:string level:int) {
        def fmt:string "decimal"
        if (nfc == 1) {
            fmt = "upperRoman"
        }
        if (nfc == 2) {
            fmt = "lowerRoman"
        }
        if (nfc == 3) {
            fmt = "upperLetter"
        }
        if (nfc == 4) {
            fmt = "lowerLetter"
        }
        def n:int (strlen lt)
        def body:string ""
        if (n > 1) {
            def i:int 1
            def from:int 1
            while (i < n) {
                def c:int (charAt lt i)
                if ((c < 9) || (c == 59)) {
                    if (i > from) {
                        body = (body + (substring lt from i))
                    }
                    if (c < 9) {
                        body = (body + "%" + (to_string (c + 1)))
                    }
                    from = (i + 1)
                    if (c == 59) {
                        i = n
                    }
                }
                i = (i + 1)
            }
            if (from < n) {
                body = (body + (substring lt from n))
            }
        }
        if (nfc == 23) {
            def ch:string body
            if ((strlen ch) == 0) {
                ch = (WordNumbering.bulletAt("•" level))
            }
            def c0:int (charAt ch 0)
            ; Symbol and Wingdings bullets, and private-use ones, are not
            ; characters any font here has.
            if (((c0 >= 57344) && (c0 <= 63743)) || ((c0 == 238) || (c0 == 239))) {
                ch = (WordNumbering.bulletAt("•" level))
            }
            if (c0 == 183) {
                ch = "•"
            }
            return ("bullet:" + ch)
        }
        if ((nfc == 255) || ((strlen body) == 0)) {
            return (fmt + ":%" + (to_string (level + 1)) + ".")
        }
        return (fmt + ":" + body)
    }

    ; The Word list for an RTF list override, made the first time a paragraph
    ; uses it: its first level's format from the list table, or failing that
    ; from the marker text the writer put in front of the paragraph.
    fn numIdFor:int (ls:int) {
        def have@(optional):int (get lsNumId ls)
        if (!null? have) {
            return (unwrap have)
        }
        def nfc:int -1
        def lid@(optional):int (get lsToList ls)
        if (!null? lid) {
            def ld@(optional):RtfListDef (get listDefs (unwrap lid))
            if (!null? ld) {
                def defn:RtfListDef (unwrap ld)
                if ((defn.firstNfc != 255) && ((array_length defn.specs) > 0)) {
                    def made:int (numbering.newListLevels(defn.specs))
                    set lsNumId ls made
                    return made
                }
            }
            def n@(optional):int (get listNfc (unwrap lid))
            if (!null? n) {
                nfc = (unwrap n)
            }
        }
        def marker:string (RtfReader.trim(lastListText))
        if (nfc < 0) {
            nfc = (RtfReader.nfcOfMarker(marker))
        }
        def id:int 0
        if (nfc == 255) {
            id = 0
        } {
            if (nfc == 23) {
                id = (numbering.newList("bullet:•"))
            } {
                def fmt:string "decimal"
                if (nfc == 1) {
                    fmt = "upperRoman"
                }
                if (nfc == 2) {
                    fmt = "lowerRoman"
                }
                if (nfc == 3) {
                    fmt = "upperLetter"
                }
                if (nfc == 4) {
                    fmt = "lowerLetter"
                }
                def suffix:string "."
                def ml:int (strlen marker)
                if (ml > 0) {
                    def last:int (charAt marker (ml - 1))
                    if ((last == 41) || (last == 46)) {
                        suffix = (strfromcode last)
                    }
                }
                id = (numbering.newList((fmt + ":%1" + suffix)))
            }
        }
        set lsNumId ls id
        return id
    }

    sfn nfcOfMarker:int (m:string) {
        if ((strlen m) == 0) {
            return 23
        }
        def c:int (charAt m 0)
        if (RtfReader.isDigit(c)) {
            return 0
        }
        if ((c >= 97) && (c <= 122)) {
            return 4
        }
        if ((c >= 65) && (c <= 90)) {
            return 3
        }
        return 23
    }

    ; ------------------------------------------------------------------
    ; Tables
    ; ------------------------------------------------------------------

    fn endCell:void () {
        if (itemAt curOpen 0) {
            this.endParagraph(false)
        }
        def cell:DocTableCell (DocTableCell.new_())
        for cellParas p:Paragraph pi {
            push cell.paragraphs p
        }
        clear cellParas
        if ((array_length cell.paragraphs) == 0) {
            def e:Paragraph (Paragraph.new_())
            clear e.spans
            push e.spans (this.spanNow())
            this.adopt(e)
            push cell.paragraphs e
        }
        push rowCells cell
    }

    ; A row's cells go into the table as they come; the columns cannot be
    ; known until the table ends, because every row states its own cell
    ; edges (a cell merged across two columns is one wide `\cellx`).
    fn endRow:void () {
        if ((itemAt curOpen 0) || ((array_length cellParas) > 0)) {
            this.endCell()
        }
        if (null? table) {
            def t:DocumentTable (doc.addTable())
            table = t
            clear tableRows
        }
        def tbl:DocumentTable (unwrap table)
        def row:DocTableRow (DocTableRow.new_())
        row.heightTwips = rowHeightTw
        def info:RtfRowInfo (new RtfRowInfo)
        info.left = rowLeftTw
        for rowCells cell:DocTableCell ci {
            def merged:boolean false
            def right:int (rowLeftTw + (1440 * (ci + 1)))
            if (ci < (array_length rowDefs)) {
                def cd2:RtfCellDef (itemAt rowDefs ci)
                merged = cd2.merged
                right = cd2.rightTw
                cell.borderTop = cd2.borderTop
                cell.borderBottom = cd2.borderBottom
                cell.borderLeft = cd2.borderLeft
                cell.borderRight = cd2.borderRight
                if (cd2.fill > 0) {
                    def fill:string (this.colorHex(cd2.fill))
                    if ((strlen fill) == 6) {
                        cell.fillHex = fill
                    }
                }
            }
            if (merged && ((array_length row.cells) > 0)) {
                removeLast info.edges
            } {
                push row.cells cell
            }
            push info.edges right
        }
        clear rowCells
        push tbl.rows row
        push tableRows info
    }

    fn closeTable:void () {
        if ((array_length cellParas) > 0) {
            ; text after the last \cell with no \row: it is still the table's
            if (!null? table) {
                this.endRow()
            }
        }
        if (!null? table) {
            this.finishGrid((unwrap table))
        }
        def none@(optional):DocumentTable
        table = none
    }

    ; Every cell edge any row has is a column boundary; each cell spans the
    ; columns between its own edges.
    fn finishGrid:void (tbl:DocumentTable) {
        def edges:[int]
        def left:int 0
        def first:boolean true
        for tableRows info:RtfRowInfo ri {
            if (first || (info.left < left)) {
                left = info.left
                first = false
            }
            for info.edges e:int ei {
                RtfReader.insertSorted(edges e)
            }
        }
        clear tbl.colWidthsTwips
        def prev:int left
        for edges e2:int ej {
            def w:int (e2 - prev)
            if (w < 100) {
                w = 100
            }
            push tbl.colWidthsTwips w
            prev = e2
        }
        def ncols:int (array_length edges)
        for tbl.rows row:DocTableRow rj {
            if (rj < (array_length tableRows)) {
                def info2:RtfRowInfo (itemAt tableRows rj)
                def cellLeft:int info2.left
                def used:int 0
                for row.cells cell:DocTableCell ck {
                    def right:int cellLeft
                    if (ck < (array_length info2.edges)) {
                        right = (itemAt info2.edges ck)
                    }
                    def span:int 0
                    for edges e3:int el {
                        if ((e3 > cellLeft) && (e3 <= right)) {
                            span = (span + 1)
                        }
                    }
                    if (span < 1) {
                        span = 1
                    }
                    cell.gridSpan = span
                    used = (used + span)
                    cellLeft = right
                }
                ; a row that stops short of the grid still fills it
                if ((used < ncols) && ((array_length row.cells) > 0)) {
                    def lastCell:DocTableCell (itemAt row.cells ((array_length row.cells) - 1))
                    lastCell.gridSpan = (lastCell.gridSpan + (ncols - used))
                }
            }
        }
    }

    sfn insertSorted:void (list:[int] v:int) {
        def n:int (array_length list)
        def i:int 0
        while (i < n) {
            def x:int (itemAt list i)
            if (x == v) {
                return
            }
            if (x > v) {
                insert list i v
                return
            }
            i = (i + 1)
        }
        push list v
    }

    ; ------------------------------------------------------------------
    ; Pictures
    ; ------------------------------------------------------------------

    fn endPicture:void () {
        if ((picKind != "png") && (picKind != "jpeg")) {
            return
        }
        def n:int (strlen picHex)
        def bytes:buffer (buffer_alloc (idiv n 2))
        def count:int 0
        def hi:int -1
        def i:int 0
        while (i < n) {
            def v:int (RtfReader.hexVal((charAt picHex i)))
            if (v >= 0) {
                if (hi < 0) {
                    hi = v
                } {
                    buffer_set bytes count ((hi * 16) + v)
                    count = (count + 1)
                    hi = -1
                }
            }
            i = (i + 1)
        }
        if (count < 8) {
            return
        }
        def data:buffer (buffer_slice bytes 0 count)
        def img:DocImage (DocImage.new_())
        img.relId = ("rtf-image-" + (to_string (doc.nextParaId)) + "." + picKind)
        img.partPath = img.relId
        def gw:int picGoalW
        def gh:int picGoalH
        if (gw <= 0) {
            gw = (idiv (picW * 1440) 96)
        }
        if (gh <= 0) {
            gh = (idiv (picH * 1440) 96)
        }
        gw = (idiv (gw * picScaleX) 100)
        gh = (idiv (gh * picScaleY) 100)
        img.widthEmu = (gw * 635)
        img.heightEmu = (gh * 635)
        img.syncPx()
        WordMlParser.decodeImageBytes(img data)
        if (img.widthEmu <= 0) {
            img.widthEmu = (img.widthPx * 9525)
            img.heightEmu = (img.heightPx * 9525)
        }
        ; the picture belongs to the paragraph it stands in
        def t:int st.target
        if ((itemAt curOpen t) == false) {
            this.openParagraph(t)
        }
        def p:Paragraph (itemAt cur t)
        push p.images img
    }
}
