; SPDX-License-Identifier: AGPL-3.0-or-later
; ==============================================================================
; DxNative - text in the target's own units, for the Rust-syntax modules.
; ==============================================================================
;
; The document model counts text offsets the way each target's strings do:
; UTF-16 units in JavaScript, bytes in Go, C++ and Rust. The .rgr code got
; that from strlen, charAt and substring; these are the same operators for
; the .rs code. Rust's own `s.as_bytes()[i]` is a UTF-8 byte on every target,
; which on JavaScript and Go makes a byte copy of the string at each call:
; a parser loop over a 4 MB document.xml became quadratic.
;
; Kept in .rgr because Ranger's Rust frontend has no spelling for these
; operators (runtime/rust/ranger ops.rs lists only snake_case ones), nor
; for reading a file.

class DxNative {
    sfn str_len:int (s:string) {
        return (strlen s)
    }
    sfn char_at:int (s:string i:int) {
        return (charAt s i)
    }
    sfn substr:string (s:string a:int b:int) {
        return (substring s a b)
    }
    sfn index_of:int (text:string key:string) {
        return (indexOf text key)
    }
    sfn index_of_from:int (text:string key:string from:int) {
        return (indexOfFrom text key from)
    }
    sfn last_index_of:int (text:string key:string) {
        return (lastIndexOf text key)
    }
    ; a file's bytes (Ranger's Rust frontend has no std::fs)
    sfn read_bytes:buffer (dir:string file:string) {
        return (buffer_read_file dir file)
    }
}
